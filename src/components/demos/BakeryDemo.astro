  /* ══════════════ Daily Sales ══════════════ */
  function refreshSales() {
    const days = dailyTotals(), entries = [...days.entries()];
    const grand = entries.reduce((s, [, v]) => s + v[2], 0), pendingValue = orders.filter(o => o.status === 'Pending').reduce((s, o) => s + total(o), 0);
    const best = entries.length ? entries.reduce((a, b) => (b[1][2] > a[1][2] ? b : a)) : null;
    $('sCards').innerHTML = card('Total sales', peso(grand), `${num(entries.reduce((s, [, v]) => s + v[0], 0))} orders · incl. ${peso(pendingValue)} pending`)
      + card('Best day', best ? peso(best[1][2]) : '—', best ? best[0] : '') + card('Average per day', entries.length ? peso(grand / entries.length) : '—', entries.length ? `across ${plural(entries.length, 'day')}` : '');
    $('sTable').innerHTML = table([{ label: 'Date', left: true }, { label: 'Orders' }, { label: 'Pieces sold' }, { label: 'Total sales' }],
      entries.reverse().map(([d, [n, pcs, amt]]) => ({ cells: [d, n, num(pcs), peso(amt)] })));
