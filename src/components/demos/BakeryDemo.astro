  /* ══════════════ Orders ══════════════ */
  let oStatus = 'All', oSel: number | null = null;
  segmented('oStatus', v => { oStatus = v; refreshOrders(); });
  function filtered() {
    const txt = $<HTMLInputElement>('oText').value.trim().toLowerCase(), prod = $<HTMLSelectElement>('oProd').value;
    const f1 = $<HTMLInputElement>('oFrom').value.trim(), f2 = $<HTMLInputElement>('oTo').value.trim();
    const d1 = f1 ? parseDate(f1) ?? '' : '', d2 = f2 ? parseDate(f2) ?? '' : '';
    return orders.filter(o => {
      if (txt && !o.customer.toLowerCase().includes(txt) && !String(o.order_id).includes(txt) && !o.product.toLowerCase().includes(txt)) return false;
      if (prod !== 'All' && o.product !== prod) return false;
      if (oStatus !== 'All' && o.status !== oStatus) return false;
      if (d1 && o.order_date < d1) return false;
      if (d2 && o.order_date > d2) return false;
      return true;
    }).sort((a, b) => (a.order_date === b.order_date ? b.order_id - a.order_id : a.order_date < b.order_date ? 1 : -1));
  }
  function refreshOrders() {
    const sel = $<HTMLSelectElement>('oProd'), keep = sel.value || 'All';
