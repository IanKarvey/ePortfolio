  /* ══════════════ Add Order ══════════════ */
  const fCust = $<HTMLInputElement>('gCust'), fProd = $<HTMLInputElement>('gProd'), fQty = $<HTMLInputElement>('gQty');
  const fPrice = $<HTMLInputElement>('gPrice'), fDate = $<HTMLInputElement>('gDate'), fStatus = $<HTMLSelectElement>('gStatus');
  let editingId: number | null = null;
  function onProduct(mode: 'empty' | 'force' = 'empty') {
    const menu = menuPrices(), typed = fProd.value.trim();
    const match = Object.keys(menu).find(p => p.toLowerCase() === typed.toLowerCase());
    if (match) {
      if (match !== fProd.value) fProd.value = match;
      if (mode === 'force' || fPrice.value.trim() === '') fPrice.value = menu[match].toFixed(2);
      updateTotal();
