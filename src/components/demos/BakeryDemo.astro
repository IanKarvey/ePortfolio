    sel.value = names.includes(keep) ? keep : 'All';
    const rows = filtered();
    $('oTable').innerHTML = table(
      [{ label: 'ID' }, { label: 'Customer', left: true }, { label: 'Product', left: true }, { label: 'Qty' }, { label: 'Unit price' }, { label: 'Total' }, { label: 'Date' }, { label: 'Status' }],
      rows.map((o, i) => ({ cells: [o.order_id, o.customer, o.product, o.quantity, o.price.toFixed(2), total(o).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }), o.order_date, o.status],
        tag: (o.order_id === oSel ? 'sel ' : '') + (o.status === 'Pending' ? 'pending' : i % 2 ? 'odd' : 'even'), key: String(o.order_id) })));
    const bad = ([[$<HTMLInputElement>('oFrom').value, 'From'], [$<HTMLInputElement>('oTo').value, 'To']] as [string, string][]).filter(([v]) => v.trim() && !parseDate(v));
    const c = $('oCount');
    c.classList.toggle('bad', bad.length > 0);
    c.innerHTML = bad.length ? `'${bad[0][1]}' date not understood - use YYYY-MM-DD`
