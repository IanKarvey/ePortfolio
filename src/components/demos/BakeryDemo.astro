    if (!prod) return messagebox('Missing info', 'Please choose or type a product.', 'error');
    if (cust.length > 80 || prod.length > 60) return messagebox('Too long', 'Customer names can be up to 80 characters and product names up to 60.', 'error');
    const qty = /^-?\d+$/.test(fQty.value.trim()) ? +fQty.value.trim() : NaN, price = fPrice.value.trim() === '' ? NaN : +fPrice.value.trim();
    if (!(qty > 0) || !(price >= 0) || !isFinite(price)) return messagebox('Invalid number', 'Quantity must be a positive whole number and price a valid number.', 'error');
    if ((qty > 10000 || price > 100000) && !(await askyesno('Check the amount', `${num(qty)} pieces at ${peso(price)} each is unusually large. Is that correct?`))) return;
    const d = parseDate(fDate.value);
    if (!d) return messagebox('Invalid date', 'Use the format YYYY-MM-DD (e.g. 2026-10-12).', 'error');
    const gap = Math.abs(daysBetween(d, todayS()));
    if (gap > 90 && !(await askyesno('Check the date', `${d} is ${gap} days from today. Is that correct?`))) return;
    if (editingId === null) {
      if (orders.some(o => o.customer.toLowerCase() === cust.toLowerCase() && o.product === prod && o.quantity === qty && o.price === price && o.order_date === d)
        && !(await askyesno('Possible duplicate', 'An identical order (same customer, product, quantity, price and date) is already recorded.\n\nSave it again anyway?'))) return;
      const id = Math.max(0, ...orders.map(o => o.order_id)) + 1;
      orders.push({ order_id: id, customer: cust, product: prod, quantity: qty, price, order_date: d, status: fStatus.value });
      await messagebox('Saved', `Order #${id} saved.\nTotal: ${peso(qty * price)}`);
    } else {
      const o = orders.find(x => x.order_id === editingId)!;
      Object.assign(o, { customer: cust, product: prod, quantity: qty, price, order_date: d, status: fStatus.value });
      await messagebox('Updated', `Order #${editingId} updated.`);
