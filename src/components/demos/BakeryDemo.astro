  });
  $('iUndo').addEventListener('click', async () => {
    if (!stock.length) return stockSay('There are no records to undo yet.', true);
    const last = stock.reduce((a, b) => (b.entry_id > a.entry_id ? b : a));
    if (!(await askyesno('Undo last record', `Remove this record?\n\n${last.quantity > 0 ? '+' : ''}${num(last.quantity)} ${last.product} on ${last.date}`))) return;
    stock = stock.filter(e => e !== last); refreshAll(); stockSay('Last record removed.');
  });

  /* ══════════════ Reports ══════════════ */
  function productTotals() {
    const qty = new Map<string, number>(), sales = new Map<string, number>();
    orders.forEach(r => { qty.set(r.product, (qty.get(r.product) ?? 0) + r.quantity); sales.set(r.product, (sales.get(r.product) ?? 0) + total(r)); });
    return { qty, sales, grand: [...sales.values()].reduce((s, v) => s + v, 0) };
  }
  function refreshReport() {
    const { qty, sales, grand } = productTotals(), days = [...dailyTotals().entries()];
    const pending = orders.filter(r => r.status === 'Pending'), pendingValue = pending.reduce((s, r) => s + total(r), 0);
    const [summary, start] = stockSummary(), best = days.length ? days.reduce((a, b) => (b[1][2] > a[1][2] ? b : a)) : null, top = mostOrdered();
    $('rCards1').innerHTML = card('Total orders', num(orders.length), `${pending.length} pending · ${orders.length - pending.length} completed`)
      + card('Pieces sold', num([...qty.values()].reduce((s, v) => s + v, 0)), plural(qty.size, 'product'))
      + card('Total sales', peso(grand), `incl. ${peso(pendingValue)} pending`)
      + card('Average per day', days.length ? peso(grand / days.length) : '—', days.length ? `across ${plural(days.length, 'day')}` : '');
    $('rCards2').innerHTML = card('Most ordered product', top ? top[0] : '—', top ? `${plural(top[1], 'order')} · ${num(top[2])} pieces` : '')
      + card('Best sales day', best ? best[0] : '—', best ? `${peso(best[1][2])} in sales` : '')
      + card('Pieces in stock', start === null ? '—' : num(Object.values(summary).reduce((s, v) => s + Math.max(0, v.have), 0)), start === null ? 'no baking records yet' : 'baked minus completed orders');
    $('rTable').innerHTML = table([{ label: 'Product', left: true }, { label: 'Pieces' }, { label: 'Sales' }, { label: 'Share of sales' }],
      [...qty.keys()].sort((a, b) => qty.get(b)! - qty.get(a)!).map(p => ({ cells: [p, num(qty.get(p)!), peso(sales.get(p)!), grand ? (sales.get(p)! / grand * 100).toFixed(1) + '%' : '0.0%'] })));
  }
  function reportText() {
    const { qty, sales, grand } = productTotals(), days = [...dailyTotals().entries()], n = new Date();
    const pend = orders.filter(r => r.status === 'Pending'), pendValue = pend.reduce((s, r) => s + total(r), 0);
    const [summary, start] = stockSummary(), w = 62;
    const lines = ['GMD BAKERY - SUMMARY REPORT', '='.repeat(w), `Generated: ${iso(n)} ${pad(n.getHours())}:${pad(n.getMinutes())}`, '',
      `Total orders ........ ${num(orders.length)}   (${pend.length} pending, ${orders.length - pend.length} completed)`,
      `Pieces ordered ...... ${num([...qty.values()].reduce((s, v) => s + v, 0))}`,
      `Total sales ......... ${peso(grand)}`, `  completed ......... ${peso(grand - pendValue)}`, `  still pending ..... ${peso(pendValue)}`];
    if (days.length) {
      const best = days.reduce((a, b) => (b[1][2] > a[1][2] ? b : a));
      lines.push(`Average per day ..... ${peso(grand / days.length)}  (over ${days.length} days)`, `Best sales day ...... ${best[0]}  (${peso(best[1][2])})`);
    }
    const top = mostOrdered();
    if (top) lines.push(`Most ordered ........ ${top[0]}  (${plural(top[1], 'order')}, ${num(top[2])} pieces)`);
    lines.push('Pieces in stock ..... ' + (start === null ? 'not tracked yet' : num(Object.values(summary).reduce((s, v) => s + Math.max(0, v.have), 0))));
    lines.push('', 'Product'.padEnd(28) + 'Pieces'.padStart(8) + 'Sales'.padStart(16) + 'Share'.padStart(9), '-'.repeat(w));
    [...qty.keys()].sort((a, b) => qty.get(b)! - qty.get(a)!).forEach(p => lines.push(p.slice(0, 27).padEnd(28) + num(qty.get(p)!).padStart(8) + peso(sales.get(p)!).padStart(16) + ((grand ? (sales.get(p)! / grand * 100).toFixed(1) : '0.0') + '%').padStart(9)));
    lines.push('', 'Daily sales (latest 14 days)', 'Date'.padEnd(14) + 'Orders'.padStart(8) + 'Pieces'.padStart(9) + 'Sales'.padStart(16), '-'.repeat(w));
    days.reverse().slice(0, 14).forEach(([d, [k, pcs, amt]]) => lines.push(d.padEnd(14) + String(k).padStart(8) + num(pcs).padStart(9) + peso(amt).padStart(16)));
    return lines.join('\n') + '\n';
  }
  $('rSave').addEventListener('click', () => notepad('report', reportText()));

  /* ══════════════ Charts (Matplotlib, drawn as SVG) ══════════════ */
  let chartKind = 'bar', lineMode = 'Daily';
  const INK = '#15231a', MUTED = '#6b7568', BORDER = '#e4e2d8', PRIMARY = '#175f27', ACCENT = '#63ab33';
  const W = 1000, H = 470;
  const T = (x: number, y: number, s: string, a = '') => `<text x="${x}" y="${y}" ${a}>${esc(s)}</text>`;
  const lerp = (a: string, b: string, t: number) => '#' + [1, 3, 5].map(i => Math.round(parseInt(a.slice(i, i + 2), 16) + (parseInt(b.slice(i, i + 2), 16) - parseInt(a.slice(i, i + 2), 16)) * t).toString(16).padStart(2, '0')).join('');
  function niceTicks(max: number) {
    const raw = max / 5, mag = Math.pow(10, Math.floor(Math.log10(raw || 1))), step = [1, 2, 2.5, 5, 10].map(m => m * mag).find(s => s >= raw) ?? mag * 10;
    const out = []; for (let v = 0; v <= max + 1e-9; v += step) out.push(v); return out;
  }
  function chartSvg(): string {
    let g = '';
    const { qty, sales } = productTotals();
    if (!orders.length) return `<svg viewBox="0 0 ${W} ${H}" class="gmd-svg">${T(W / 2, H / 2, 'No data yet', 'class="gx-mut" text-anchor="middle"')}</svg>`;
    if (chartKind === 'bar') {
      const items = [...qty.entries()].sort((a, b) => a[1] - b[1]), top = Math.max(...items.map(i => i[1]));
      const L = 200, R = 960, Tp = 70, B = 400, xmax = top * 1.12, slot = (B - Tp) / items.length;
      g += T(L, 34, 'Quantity sold per product', 'class="gx-t"');
      niceTicks(xmax).forEach(v => { const x = L + ((R - L) * v) / xmax; g += `<line x1="${x}" y1="${Tp}" x2="${x}" y2="${B}" stroke="${BORDER}" stroke-opacity=".8"/>` + T(x, B + 20, num(v), 'class="gx-tk" text-anchor="middle"'); });
      items.forEach(([k, v], i) => {
        const y = B - slot * (i + 1) + slot * 0.19, h = slot * 0.62, w = ((R - L) * v) / xmax;
        g += `<rect class="gx-grow" x="${L}" y="${y}" width="${w}" height="${h}" fill="${lerp('#a8d27a', PRIMARY, v / top)}"/>`
          + T(L - 8, y + h / 2 + 4, k, 'class="gx-tk" text-anchor="end"') + T(L + w + 5, y + h / 2 + 4, String(v), 'class="gx-lb"');
      });
      g += `<line x1="${L}" y1="${B}" x2="${R}" y2="${B}" stroke="${BORDER}"/>` + T((L + R) / 2, B + 44, 'Pieces', 'class="gx-al" text-anchor="middle"');
    } else if (chartKind === 'line') {
      const days = [...dailyTotals().entries()];
      const multiYear = new Set(days.map(([d]) => d.slice(0, 4))).size > 1;
      let labels: string[], ys: number[], xlabel: string;
      if (lineMode === 'Weekly') {
        const wk = new Map<string, number>();
        days.forEach(([d, v]) => { const dt = toDate(d); dt.setDate(dt.getDate() - ((dt.getDay() + 6) % 7)); const k = iso(dt); wk.set(k, (wk.get(k) ?? 0) + v[2]); });
        const keys = [...wk.keys()].sort();
        labels = keys.map(k => { const dt = toDate(k); return `${MONTHS[dt.getMonth()].slice(0, 3)} ${pad(dt.getDate())}${multiYear ? ', ' + dt.getFullYear() : ''}`; });
        ys = keys.map(k => wk.get(k)!); xlabel = 'Week starting';
      } else { labels = days.map(([d]) => (multiYear ? d : d.slice(5))); ys = days.map(([, v]) => v[2]); xlabel = multiYear ? 'Date' : 'Date (MM-DD)'; }
      const L = 120, R = 960, Tp = 70, B = 360, ymax = ys.length && Math.max(...ys) > 0 ? Math.max(...ys) * 1.1 : 1;
      const X = (i: number) => L + ((R - L) * (i + 0.5)) / Math.max(ys.length, 1), Y = (v: number) => B - ((B - Tp) * v) / ymax;
      g += T(L, 34, `${lineMode} sales trend`, 'class="gx-t"');
      niceTicks(ymax).forEach(v => { g += `<line x1="${L}" y1="${Y(v)}" x2="${R}" y2="${Y(v)}" stroke="${BORDER}" stroke-opacity=".8"/>` + T(L - 10, Y(v) + 4, String(Math.round(v)), 'class="gx-tk" text-anchor="end"'); });
      const path = ys.map((v, i) => `${i ? 'L' : 'M'}${X(i)} ${Y(v)}`).join(' ');
      if (ys.length) g += `<path d="${path} L${X(ys.length - 1)} ${Y(0)} L${X(0)} ${Y(0)} Z" fill="${ACCENT}" fill-opacity=".14"/><path class="gx-draw" d="${path}" fill="none" stroke="${ACCENT}" stroke-width="2.8" stroke-linejoin="round"/>`;
      ys.forEach((v, i) => { g += `<circle cx="${X(i)}" cy="${Y(v)}" r="4.6" fill="${ACCENT}"/>`; });
      const step = Math.max(1, Math.floor(ys.length / 12));
      labels.forEach((l, i) => { if (i % step === 0) g += T(X(i), B + 14, l, `class="gx-tk" text-anchor="end" transform="rotate(-45 ${X(i)} ${B + 14})"`); });
      g += `<line x1="${L}" y1="${Tp - 10}" x2="${L}" y2="${B}" stroke="${BORDER}"/><line x1="${L}" y1="${B}" x2="${R}" y2="${B}" stroke="${BORDER}"/>`
        + T((L + R) / 2, H - 16, xlabel, 'class="gx-al" text-anchor="middle"') + T(52, (Tp + B) / 2, 'Sales (₱)', `class="gx-al" text-anchor="middle" transform="rotate(-90 52 ${(Tp + B) / 2})"`);
    } else {
      const items = [...sales.entries()].filter(([, v]) => v > 0).sort((a, b) => b[1] - a[1]);
      if (!items.length) return `<svg viewBox="0 0 ${W} ${H}" class="gmd-svg">${T(W / 2, H / 2, 'No sales to show', 'class="gx-mut" text-anchor="middle"')}</svg>`;
      const sum = items.reduce((s, [, v]) => s + v, 0), cx = W / 2, cy = 255, r = 165;
      g += T(cx - r - 40, 34, 'Share of total sales by product', 'class="gx-t"');
      let a0 = -Math.PI / 2;  // startangle=90, counter-clockwise like matplotlib
      items.forEach(([k, v], i) => {
        const span = (2 * Math.PI * v) / sum, a1 = a0 - span, color = CHART_COLORS[i % CHART_COLORS.length];
        const p = (a: number, rr: number) => `${cx + rr * Math.cos(a)} ${cy + rr * Math.sin(a)}`;
        g += items.length === 1 ? `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${color}"/>`
          : `<path d="M${cx} ${cy} L${p(a0, r)} A${r} ${r} 0 ${span > Math.PI ? 1 : 0} 0 ${p(a1, r)} Z" fill="${color}" stroke="#fff" stroke-width="2.5"/>`;
        const mid = (a0 + a1) / 2, [rr, gg, bb] = [1, 3, 5].map(j => parseInt(color.slice(j, j + 2), 16));
        const dark = 0.299 * rr + 0.587 * gg + 0.114 * bb < 140;
        g += T(cx + r * 0.8 * Math.cos(mid), cy + r * 0.8 * Math.sin(mid) + 4, ((v / sum) * 100).toFixed(1) + '%', `class="gx-pct" text-anchor="middle" fill="${dark ? '#fff' : INK}"`)
          + T(cx + r * 1.1 * Math.cos(mid), cy + r * 1.1 * Math.sin(mid) + 4, k, `class="gx-lb" text-anchor="${Math.cos(mid) >= 0 ? 'start' : 'end'}"`);
        a0 = a1;
      });
    }
    return `<svg viewBox="0 0 ${W} ${H}" class="gmd-svg" role="img" aria-label="Chart">${g}</svg>`;
  }
  function refreshCharts() {
    if (current !== 6) return;
    $('cMode').hidden = chartKind !== 'line';
    $('cChart').innerHTML = chartSvg();
  }
  $('cKind').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-k]'); if (!b) return;
    chartKind = b.dataset.k!; $('cKind').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)); refreshCharts();
  });
  segmented('cMode', v => { lineMode = v; refreshCharts(); });

  /* ══════════════ refresh_all ══════════════ */
  function refreshAll() {
    $('gProds').innerHTML = Object.keys(menuPrices()).map(p => `<option value="${esc(p)}">`).join('');
    refreshRecent(); refreshOrders(); refreshSales(); refreshProd(); refreshStock(); refreshReport(); refreshHeader(); refreshCharts();
  }

  fDate.value = todayS();
  $<HTMLInputElement>('iDate').value = todayS();
  $<HTMLInputElement>('pDate').value = defaultProdDate();
  refreshAll();
  requestAnimationFrame(moveLine);
  addEventListener('load', moveLine);
  document.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !$('gmdMsg').hidden) { e.preventDefault(); ($('gmdMbBtns').querySelector('button') as HTMLButtonElement).click(); }
    else if (e.key === 'Escape') { if (!$('gmdMsg').hidden) ($('gmdMbBtns').lastElementChild as HTMLButtonElement).click(); else $('gmdNp').hidden = true; }
  });
  $('iQty').addEventListener('keydown', e => { if (e.key === 'Enter') $('iRecord').click(); });
</script>

<style is:global>
  /* palette from bakery_planner.py */
  .gmd{position:relative;left:50%;transform:translateX(-50%);width:min(1180px,calc(100vw - 32px))}
  .gmd-win{--bg:#f5f4ee;--surface:#fff;--border:#e4e2d8;--ink:#15231a;--muted:#6b7568;--label:#3f4d3f;--primary:#175f27;--primaryh:#114a1e;
    --accent:#63ab33;--soft:#e7f1e1;--sel:#dcebd2;--pend:#fff7e0;--danger:#b3261e;--ui:"Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
    border-radius:8px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.08)}
  .gmd-bar{display:flex;align-items:center;gap:10px;height:32px;padding-left:12px;background:#f3f3f3;color:#1b1b1b;font:12px var(--ui);border-bottom:1px solid #e5e5e5}
  .gmd-bar img{width:16px;height:16px;border-radius:2px;object-fit:cover}
  .gmd-caps{margin-left:auto;display:flex;height:100%;font-style:normal}
  .gmd-caps b{width:46px;display:grid;place-items:center;font-weight:400;font-size:11px}

  .gmd-app{position:relative;height:790px;display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font:13.3px/1.35 var(--ui);border-top:4px solid var(--primary)}
  .gmd-app *{box-sizing:border-box}
  .gmd-head{display:flex;align-items:center;gap:16px;padding:6px 34px 6px 34px;background:var(--surface);flex:none}
  .gmd-logo{width:64px;height:64px;border-radius:50%;object-fit:cover}
  .gmd-names b{display:block;font:700 25.3px/1.15 Georgia,"Times New Roman",serif;color:var(--primary)}
  .gmd-names span{display:block;font-size:13.3px;color:var(--muted)}
  .gmd-right{margin-left:auto;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
  .gmd-right span{font-size:13.3px;color:var(--label)}
  .gmd-right em{font-style:normal;padding:5px 14px;border-radius:14px;background:var(--soft);color:var(--primary);font:600 12px var(--ui)}
  .gmd-tabs{position:relative;display:flex;gap:2px;padding:0 28px;background:var(--surface);border-bottom:1px solid var(--border);flex:none;overflow-x:auto;scrollbar-width:none}
  .gmd-tabs button{height:46px;padding:0 20px;border:none;background:none;font:600 14.7px var(--ui);color:var(--muted);white-space:nowrap;cursor:pointer}
  .gmd-tabs button:hover{color:var(--ink)}
  .gmd-tabs button.on{color:var(--ink)}
  .gmd-line{position:absolute;bottom:0;height:3px;background:var(--accent);transition:left .26s cubic-bezier(.25,1,.5,1),width .26s}

  .gmd-pages{flex:1;min-height:0;position:relative;padding:0 34px}
  .gmd-page{display:none;height:100%;flex-direction:column;padding-bottom:12px}
  .gmd-page.on{display:flex;animation:gmdIn .26s cubic-bezier(.25,1,.5,1)}
  @keyframes gmdIn{from{opacity:0;transform:translateX(30px)}}
  .gmd-note{margin:16px 3px 12px;font-size:13.3px;color:var(--muted);flex:none}
  .gmd-note.edit{color:var(--primary);font-weight:700}
  .gmd-card{background:var(--surface);border:1px solid var(--border)}

  /* entries and combos (ttk) */
  .gmd-app label{display:flex;flex-direction:column;gap:4px;font-size:13.3px;color:var(--label);min-width:0}
  .gmd-in{height:36px;padding:0 9px;border:1px solid #c7cabd;border-radius:3px;background:#fff;color:var(--ink);font:13.3px var(--ui);outline:none;width:100%}
  .gmd-in:focus{border-color:var(--primary);box-shadow:inset 0 -2px 0 var(--primary)}
  .gmd-cb{appearance:none;-webkit-appearance:none;padding-right:30px;background:linear-gradient(45deg,transparent 50%,#555 50%) calc(100% - 15px) 52%/5px 5px no-repeat,linear-gradient(-45deg,transparent 50%,#555 50%) calc(100% - 10px) 52%/5px 5px no-repeat #fff}
  .gmd-cb::-webkit-calendar-picker-indicator{opacity:0}
  .w7{width:90px}.w10{width:120px}.w11{width:130px}.w13{width:150px}.w20{width:220px}

  /* RoundButton */
  .gmd-btn{height:40px;min-width:90px;padding:0 20px;border:none;border-radius:8px;background:var(--primary);color:#fff;font:600 13.3px var(--ui);white-space:nowrap;cursor:pointer;transition:background .15s}
  .gmd-btn:hover{background:var(--primaryh)}
  .gmd-btn.ghost{background:#eceee4;color:var(--ink)}
  .gmd-btn.ghost:hover{background:#dde3d2}
  .gmd-btn.danger{background:#fff;color:var(--danger);box-shadow:inset 0 0 0 1px #e8b4b0}
  .gmd-btn.danger:hover{background:#fdeceb}
  .gmd-btn.chip{height:32px;min-width:0;padding:0 14px;font-size:13.3px}
  .gmd-btn:focus-visible,.gmd-seg button:focus-visible,.gmd-tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  /* Segmented */
  .gmd-seg{display:inline-flex;padding:4px;border-radius:10px;background:#e9e9df;gap:2px}
  .gmd-seg button{height:30px;padding:0 16px;border:none;border-radius:7px;background:none;color:var(--label);font:13px var(--ui);cursor:pointer;white-space:nowrap}
  .gmd-seg button.on{background:#fff;color:var(--ink);box-shadow:0 0 0 1px #d8d9cc}
  .gmd-seg.big button{min-width:150px}

  /* Add Order */
  .gmd-add{flex:1;min-height:0;display:grid;grid-template-columns:7fr 4fr;gap:24px}
  .gmd-form{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 12px;align-content:start;padding:20px 22px}
  .gmd-form .s2{grid-column:span 2}.gmd-form .s4{grid-column:span 4}
  .gmd-total{display:flex;justify-content:space-between;align-items:center;padding:10px 18px;background:var(--soft);color:var(--label);font-size:14.7px}
  .gmd-total b{font-size:28px;color:var(--primary)}
  .gmd-btns{display:flex;gap:10px}
  .gmd-btns .gmd-btn:first-child{min-width:150px}
  .gmd-recent{display:flex;flex-direction:column;min-height:0;overflow:hidden}
  .gmd-recent h4{margin:16px 20px 10px;font:700 16px var(--ui);color:var(--ink)}
  .gmd-recent .gmd-tbl{flex:none}
  .gmd-mark{margin:auto auto 14px;width:130px;height:130px;border-radius:50%;opacity:.12;filter:grayscale(.2)}

  /* tables (ttk.Treeview) */
  .gmd-tbl{display:flex;min-height:0}
  .gmd-fill{flex:1}
  .gmd-scroll{flex:1;min-height:0;overflow:auto;scrollbar-color:#cfd3c4 var(--bg)}
  .gmd-app table{width:100%;border-collapse:collapse;font-size:13.3px}
  .gmd-app th{position:sticky;top:0;height:33px;padding:0 8px;background:#f1f1e8;color:var(--label);font-weight:600;text-align:right;white-space:nowrap}
  .gmd-app td{height:30px;padding:0 8px;text-align:right;white-space:nowrap}
  .gmd-app th.l,.gmd-app td.l{text-align:left}
  #oTable th,#oTable td{text-align:center}#oTable .l{text-align:left}
  .gmd-app tr.even td{background:#fff}
  .gmd-app tr.odd td{background:#faf9f4}
  .gmd-app tr.pending td{background:var(--pend)}
  .gmd-app tr.sel td{background:var(--sel)}
  .gmd-app tr[data-key]{cursor:pointer}

  /* Orders */
  .gmd-filter{display:flex;align-items:flex-end;gap:10px;padding:12px 16px 14px;margin-bottom:14px;flex:none;flex-wrap:wrap}
  .gmd-filter .grow{flex:1;min-width:120px}
  .gmd-filter #oProd{width:190px}
  .gmd-filter .gmd-btn{min-width:72px;margin-left:2px}
  .gmd-bottom{display:flex;align-items:center;gap:8px;margin-top:14px;flex:none;color:var(--muted)}
  .gmd-bottom>span{margin-right:auto;font-size:13.3px;white-space:pre-wrap}
  .gmd-bottom .bad,.gmd-msgline.bad{color:var(--danger)}
  #oDone{min-width:150px}#iUndo{min-width:150px}#rSave{min-width:130px}
  #iMsg.good{color:var(--primary);transition:none}
  #iMsg.fade{color:var(--muted);transition:color 2.5s ease-in-out}

  /* stat cards */
  .gmd-cards{display:grid;gap:14px;margin-bottom:16px;flex:none}
  .gmd-cards.c3{grid-template-columns:repeat(3,1fr)}.gmd-cards.c4{grid-template-columns:repeat(4,1fr)}
  .gmd-stat{display:flex;flex-direction:column;gap:2px;padding:16px 20px 14px;min-width:0}
  .gmd-stat span{font-size:13.3px;color:var(--label)}
  .gmd-stat b{font-size:28px;font-weight:600;color:var(--primary);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gmd-stat small{font-size:12px;color:var(--muted);min-height:16px}
  #rCards2 .gmd-stat b{font-size:28px}

  /* Production Plan / Inventory controls */
  .gmd-ctl{padding:12px 18px;margin-bottom:12px;flex:none}
  .gmd-ctlrow{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap}
  .gmd-ctlrow .right{margin-left:auto;min-width:110px}
