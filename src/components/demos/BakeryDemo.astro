  /* ══════════════ Production Plan ══════════════ */
  let pTouched = false, pPending = true;
  function defaultProdDate() {
    const t = todayS(), pending = [...new Set(orders.filter(o => o.status === 'Pending' && o.order_date >= t).map(o => o.order_date))].sort();
    return pending[0] ?? t;
  }
  function planRows(d: string): [[string, number, number, number, number | null, number][], boolean] {
    const agg = new Map<string, [number, number, number]>();
    orders.forEach(o => {
      if (o.order_date === d && (!pPending || o.status === 'Pending')) {
        const a = agg.get(o.product) ?? [0, 0, 0]; a[0]++; a[1] += o.quantity; a[2] += o.status === 'Pending' ? o.quantity : 0; agg.set(o.product, a);
      }
    });
    const [summary, start] = stockSummary(), tracking = start !== null;
    const rows = [...agg.entries()].sort((a, b) => b[1][1] - a[1][1]).map(([prod, [n, qty, pend]]) => {
      const have = tracking ? Math.max(0, summary[prod]?.have ?? 0) : null;
      return [prod, n, qty, pend, have, have === null ? pend : Math.max(0, pend - have)] as [string, number, number, number, number | null, number];
    });
    return [rows, tracking];
  }
  function refreshProdChips(selected: string) {
    const t = todayS(), pieces = new Map<string, number>();
    orders.filter(o => o.status === 'Pending').forEach(o => pieces.set(o.order_date, (pieces.get(o.order_date) ?? 0) + o.quantity));
    const upcoming = [...pieces.keys()].filter(x => x >= t).sort().slice(0, 4);
    const overdue = [...pieces.keys()].filter(x => x < t).sort().reverse().slice(0, Math.max(0, 4 - upcoming.length));
    const chips = [...upcoming, ...overdue];
    $('pChips').innerHTML = chips.length ? chips.map(x => {
      const name = x === t ? 'Today' : x === dayAt(1) ? 'Tomorrow' : chipDate(x);
      return `<button type="button" class="gmd-btn chip ${x === selected ? '' : 'ghost'}" data-d="${x}">${name} &nbsp;·&nbsp; ${num(pieces.get(x)!)} pcs${x < t ? ' &nbsp;(overdue)' : ''}</button>`;
    }).join('') : '<span class="muted">none yet. Add an order first.</span>';
    return chips.length;
  }
  function refreshProd() {
    const d = parseDate($<HTMLInputElement>('pDate').value);
    const msg = $('pMsg');
    if (!d) {
      msg.textContent = 'Invalid date — use YYYY-MM-DD'; msg.classList.add('bad');
      $('pCards').innerHTML = card('Pieces needed', '—', '') + card('Already in stock', '—', '') + card('Still to bake', '—', '');
      $('pTable').innerHTML = table([{ label: 'Product', left: true }, { label: 'Orders' }, { label: 'Pieces needed' }, { label: 'In stock' }, { label: 'Still to bake' }], []);
      return;
    }
    const [rows, tracking] = planRows(d);
    $('pTable').innerHTML = table([{ label: 'Product', left: true }, { label: 'Orders' }, { label: 'Pieces needed' }, { label: 'In stock' }, { label: 'Still to bake' }],
      rows.map((r, i) => ({ cells: [r[0], r[1], num(r[2]), r[4] === null ? '—' : num(r[4]), num(r[5])], tag: r[5] > 0 ? 'pending' : i % 2 ? 'odd' : 'even' })));
    $('pCards').innerHTML = card('Pieces needed', num(rows.reduce((s, r) => s + r[2], 0)), `${plural(rows.length, 'product')} · ${plural(rows.reduce((s, r) => s + r[1], 0), 'order')}`)
      + card('Already in stock', tracking ? num(rows.reduce((s, r) => s + Math.min(r[4]!, r[3]), 0)) : '—', tracking ? 'covered by what you already baked' : 'no baking records yet')
      + card('Still to bake', num(rows.reduce((s, r) => s + r[5], 0)), `for ${d}`);
    const nChips = refreshProdChips(d);
    const which = pPending ? 'pending orders' : 'orders';
    msg.classList.remove('bad');
    msg.textContent = rows.length ? `Showing ${which} for ${d}, biggest quantity first.  ` + (tracking ? 'Stock comes from the Inventory tab.' : 'Record what you bake on the Inventory tab to see what is already in stock.')
      : nChips ? `Nothing to bake for ${d} yet. Click one of the dates above that has orders.` : 'No pending orders yet. Add an order on the Add Order tab and it will appear here.';
  }
  $('pDate').addEventListener('keydown', () => { pTouched = true; });
  $('pDate').addEventListener('input', () => { if ($<HTMLInputElement>('pDate').value.trim().length >= 10) refreshProd(); });
  document.querySelectorAll<HTMLElement>('#gmd [data-pday]').forEach(b => b.addEventListener('click', () => { pTouched = true; $<HTMLInputElement>('pDate').value = dayAt(+b.dataset.pday!); refreshProd(); }));
  $('pChips').addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-d]'); if (b) { pTouched = true; $<HTMLInputElement>('pDate').value = b.dataset.d!; refreshProd(); } });
  segmented('pMode', v => { pPending = v === 'Pending only'; refreshProd(); });
  function bakeSheetText(d: string) {
    const [rows, tracking] = planRows(d), w = 62, n = new Date();
    const lines = ['GMD BAKERY - BAKE SHEET', '='.repeat(w), `Bake for : ${longDate(d)}`, `Orders   : ${pPending ? 'pending orders only' : 'all orders'}`,
      `Printed  : ${iso(n)} ${pad(n.getHours())}:${pad(n.getMinutes())}`, '', 'Product'.padEnd(28) + 'Needed'.padStart(8) + 'In stock'.padStart(10) + 'To bake'.padStart(10), '-'.repeat(w)];
    rows.forEach(r => lines.push(r[0].slice(0, 27).padEnd(28) + num(r[2]).padStart(8) + (r[4] === null ? '-' : num(r[4])).padStart(10) + num(r[5]).padStart(10)));
    lines.push('-'.repeat(w), 'TOTAL'.padEnd(28) + num(rows.reduce((s, r) => s + r[2], 0)).padStart(8) + (tracking ? num(rows.reduce((s, r) => s + Math.min(r[4]!, r[3]), 0)) : '-').padStart(10) + num(rows.reduce((s, r) => s + r[5], 0)).padStart(10), '', 'Orders for this day:');
    orders.filter(o => o.order_date === d && (!pPending || o.status === 'Pending')).sort((a, b) => a.order_id - b.order_id)
      .forEach(o => lines.push(`  #${String(o.order_id).padEnd(5)} ${o.customer.slice(0, 24).padEnd(25)} ${num(o.quantity).padStart(5)} x ${o.product}  [${o.status}]`));
    return lines.join('\n') + '\n';
  }
  $('pPrint').addEventListener('click', () => {
    const d = parseDate($<HTMLInputElement>('pDate').value);
    if (!d) return messagebox('Invalid date', 'Pick a valid date first (YYYY-MM-DD).', 'error');
    if (!planRows(d)[0].length) return messagebox('Nothing to print', `There is nothing to bake for ${d}.`);
    notepad(`bake-sheet-${d}`, bakeSheetText(d));
  });

  /* ══════════════ Inventory ══════════════ */
  let stKind = 'Baked', sayTimer = 0;
  segmented('iKind', v => { stKind = v; });
  function stockSay(text: string, error = false) {
    const el = $('iMsg');
    el.textContent = text; el.className = error ? 'bad' : 'good';
    clearTimeout(sayTimer);
    if (!error) sayTimer = window.setTimeout(() => { el.className = 'fade'; }, 60);
  }
  function refreshStock() {
    const [summary, start] = stockSummary();
    const rows = Object.entries(summary).sort((a, b) => b[1].short - a[1].short || (a[0] < b[0] ? -1 : 1));
    $('iTable').innerHTML = table([{ label: 'Product', left: true }, { label: 'Baked' }, { label: 'Sold' }, { label: 'In stock' }, { label: 'Orders waiting' }, { label: 'Still to bake' }],
      rows.map(([p, v], i) => ({ cells: [p, num(v.baked), num(v.sold), num(v.have), num(v.waiting), num(v.short)], tag: v.short > 0 ? 'pending' : i % 2 ? 'odd' : 'even' })));
    if (start === null) {
      $('iCards').innerHTML = card('Pieces in stock', '—', 'no baking records yet') + card('Still to bake', '—', 'no baking records yet') + card('Products running short', '—', 'no baking records yet');
      return;
    }
    const vals = Object.values(summary), shortRows = vals.filter(v => v.short > 0);
    $('iCards').innerHTML = card('Pieces in stock', num(vals.reduce((s, v) => s + Math.max(0, v.have), 0)), `across ${plural(vals.filter(v => v.have > 0).length, 'product')}`)
      + card('Still to bake', num(shortRows.reduce((s, v) => s + v.short, 0)), 'for the orders that are waiting')
      + card('Products running short', String(shortRows.length), `of ${plural(vals.length, 'product')}`);
    if (!$('iMsg').classList.contains('good') && !$('iMsg').classList.contains('bad'))
      $('iMsg').textContent = `${stock.length} records since ${start}.  Yellow rows still need baking for the orders that are waiting.`;
  }
  $('iRecord').addEventListener('click', async () => {
    const menu = menuPrices(), typed = $<HTMLInputElement>('iProd').value.trim();
    const prod = Object.keys(menu).find(p => p.toLowerCase() === typed.toLowerCase()) ?? typed;
    if (!prod) return stockSay('Please choose or type a product first.', true);
    if (prod.length > 60) return stockSay('Product names can be up to 60 characters.', true);
    const q = $<HTMLInputElement>('iQty').value.trim(), qty = /^\d+$/.test(q) ? +q : 0;
    if (qty <= 0 || qty > 100000) return stockSay('Pieces must be a positive whole number.', true);
    const d = parseDate($<HTMLInputElement>('iDate').value);
    if (!d) return stockSay('Use the date format YYYY-MM-DD (e.g. 2026-10-12).', true);
    const gap = Math.abs(daysBetween(d, todayS()));
    if (gap > 90 && !(await askyesno('Check the date', `${d} is ${gap} days from today. Is that correct?`))) return;
    if (qty > 10000 && !(await askyesno('Check the amount', `${num(qty)} pieces is unusually large. Is that correct?`))) return;
    const signed = stKind === 'Baked' ? qty : -qty;
    stock.push({ entry_id: Math.max(0, ...stock.map(e => e.entry_id)) + 1, date: d, product: prod, quantity: signed });
    $<HTMLInputElement>('iQty').value = '1';
