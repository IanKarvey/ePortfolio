---
/* GMD Bakery Planner — the real program's window, rebuilt for the browser.
   All seven tabs with the same palette, wording, rules and numbers as bakery_planner.py,
   running on the sample data the program itself generates on first start. */
---
<div class="gmd" id="gmd">
  <div class="gmd-win">
    <div class="gmd-bar">
      <img src="/projects/gmd-bakery-badge.jpg" alt="" width="16" height="16">
      <span>GMD Bakery - Order and Production Planner</span>
      <i class="gmd-caps" aria-hidden="true"><b>&#8212;</b><b>&#9633;</b><b>&#10005;</b></i>
    </div>

    <div class="gmd-app" id="gmdApp" data-lenis-prevent>
      <header class="gmd-head">
        <img src="/projects/gmd-bakery-badge.jpg" alt="GMD Bakery logo" class="gmd-logo">
        <div class="gmd-names"><b>GMD Bakery</b><span>Order and Production Planner</span></div>
        <div class="gmd-right"><span id="gmdToday"></span><em id="gmdPending"></em></div>
      </header>
      <nav class="gmd-tabs" role="tablist" aria-label="Tabs">
        <button type="button" class="on" data-tab="0" role="tab">Add Order</button>
        <button type="button" data-tab="1" role="tab">Orders</button>
        <button type="button" data-tab="2" role="tab">Daily Sales</button>
        <button type="button" data-tab="3" role="tab">Production Plan</button>
        <button type="button" data-tab="4" role="tab">Inventory</button>
        <button type="button" data-tab="5" role="tab">Reports</button>
        <button type="button" data-tab="6" role="tab">Charts</button>
        <i class="gmd-line" id="gmdLine"></i>
      </nav>

      <div class="gmd-pages">
        <!-- Add Order -->
        <section class="gmd-page on" data-tab="0">
          <p class="gmd-note" id="gmdAddNote">Record a customer order. Pick a product and the price fills in by itself.</p>
          <div class="gmd-add">
            <form class="gmd-card gmd-form" id="gmdForm" novalidate>
              <label class="s2">Customer name<input id="gCust" class="gmd-in" autocomplete="off"></label>
              <label class="s2">Product &nbsp;(pick or type a new one)<input id="gProd" class="gmd-in gmd-cb" list="gProds" autocomplete="off"><datalist id="gProds"></datalist></label>
              <label>Quantity<input id="gQty" class="gmd-in" type="number" min="1" max="1000" value="1"></label>
              <label>Unit price (₱)<input id="gPrice" class="gmd-in" inputmode="decimal" autocomplete="off"></label>
              <label>Date needed<input id="gDate" class="gmd-in" autocomplete="off"></label>
              <label>Status<select id="gStatus" class="gmd-in gmd-cb"><option>Pending</option><option>Completed</option></select></label>
              <div class="gmd-total s4"><span>Order total</span><b id="gTotal">₱0.00</b></div>
              <div class="gmd-btns s4"><button type="submit" class="gmd-btn" id="gSave">Save order</button><button type="button" class="gmd-btn ghost" id="gClear">Clear</button></div>
            </form>
            <div class="gmd-card gmd-recent">
              <h4>Latest orders</h4>
              <div class="gmd-tbl" id="gRecent"></div>
              <img src="/projects/gmd-bakery-badge.jpg" alt="" class="gmd-mark">
            </div>
          </div>
        </section>

        <!-- Orders -->
        <section class="gmd-page" data-tab="1">
          <p class="gmd-note">Search, filter and manage every order.</p>
          <div class="gmd-card gmd-filter">
            <label class="grow">Search<input id="oText" class="gmd-in" autocomplete="off"></label>
            <label>Product<select id="oProd" class="gmd-in gmd-cb"></select></label>
            <label>Status<span class="gmd-seg" id="oStatus"><button type="button" class="on">All</button><button type="button">Pending</button><button type="button">Completed</button></span></label>
            <label>From date<input id="oFrom" class="gmd-in w10" autocomplete="off"></label>
            <label>To date<input id="oTo" class="gmd-in w10" autocomplete="off"></label>
            <button type="button" class="gmd-btn ghost" id="oReset">Reset</button>
          </div>
          <div class="gmd-card gmd-tbl gmd-fill" id="oTable"></div>
          <div class="gmd-bottom">
            <span id="oCount"></span>
            <button type="button" class="gmd-btn" id="oDone">Mark completed</button>
            <button type="button" class="gmd-btn ghost" id="oEdit">Edit</button>
            <button type="button" class="gmd-btn danger" id="oDel">Delete</button>
          </div>
        </section>

        <!-- Daily Sales -->
        <section class="gmd-page" data-tab="2">
          <p class="gmd-note">How much the bakery earned on each day.</p>
          <div class="gmd-cards c3" id="sCards"></div>
          <div class="gmd-card gmd-tbl gmd-fill" id="sTable"></div>
        </section>

        <!-- Production Plan -->
        <section class="gmd-page" data-tab="3">
          <p class="gmd-note">The baker's to-do list: pick a date and the list updates by itself, showing how many pieces of each product to bake.</p>
          <div class="gmd-card gmd-ctl">
            <div class="gmd-ctlrow">
              <label>Date to bake for<input id="pDate" class="gmd-in w13" autocomplete="off"></label>
              <button type="button" class="gmd-btn ghost" data-pday="0">Today</button>
              <button type="button" class="gmd-btn ghost" data-pday="1">Tomorrow</button>
              <span class="gmd-seg" id="pMode"><button type="button" class="on">Pending only</button><button type="button">All orders</button></span>
              <button type="button" class="gmd-btn right" id="pPrint">Print bake sheet</button>
            </div>
            <div class="gmd-chips"><span>Dates with orders to bake:</span><span id="pChips"></span></div>
          </div>
          <div class="gmd-cards c3" id="pCards"></div>
          <div class="gmd-card gmd-tbl gmd-fill" id="pTable"></div>
          <p class="gmd-msgline" id="pMsg"></p>
        </section>

        <!-- Inventory -->
        <section class="gmd-page" data-tab="4">
          <p class="gmd-note">Keep count of what you bake. In stock = pieces baked minus orders marked Completed since your first record.</p>
          <div class="gmd-card gmd-ctl">
            <div class="gmd-ctlrow">
              <label>Product<input id="iProd" class="gmd-in gmd-cb w20" list="gProds" autocomplete="off"></label>
              <label>What happened<span class="gmd-seg" id="iKind"><button type="button" class="on">Baked</button><button type="button">Used / wasted</button></span></label>
              <label>Pieces<input id="iQty" class="gmd-in w7" type="number" min="1" max="10000" value="1"></label>
              <label>Date<input id="iDate" class="gmd-in w11" autocomplete="off"></label>
              <button type="button" class="gmd-btn right" id="iRecord">Record</button>
            </div>
          </div>
          <div class="gmd-cards c3" id="iCards"></div>
          <div class="gmd-card gmd-tbl gmd-fill" id="iTable"></div>
          <div class="gmd-bottom"><span id="iMsg"></span><button type="button" class="gmd-btn ghost" id="iUndo">Undo last record</button></div>
        </section>

        <!-- Reports -->
        <section class="gmd-page" data-tab="5">
          <p class="gmd-note">A summary of orders, pieces and sales.</p>
          <div class="gmd-cards c4" id="rCards1"></div>
          <div class="gmd-cards c3" id="rCards2"></div>
          <div class="gmd-card gmd-tbl gmd-fill" id="rTable"></div>
          <div class="gmd-bottom"><span>Saves a plain-text copy of this report that you can print or send.</span><button type="button" class="gmd-btn ghost" id="rSave">Save report</button></div>
        </section>

        <!-- Charts -->
        <section class="gmd-page" data-tab="6">
          <p class="gmd-note">See what sells best and how sales change over time.</p>
          <div class="gmd-charttop">
            <span class="gmd-seg big" id="cKind"><button type="button" class="on" data-k="bar">Quantity per product</button><button type="button" data-k="line">Sales trend</button><button type="button" data-k="pie">Sales share</button></span>
            <span class="gmd-seg" id="cMode" hidden><button type="button" class="on">Daily</button><button type="button">Weekly</button></span>
          </div>
          <div class="gmd-card gmd-fill gmd-chart" id="cChart"></div>
        </section>
      </div>

      <footer class="gmd-foot">Orders are saved in &nbsp;C:\Users\Owner\Desktop\GMD Bakery Planner\orders.csv</footer>

      <!-- Windows message box (tkinter.messagebox) -->
      <div class="gmd-over" id="gmdMsg" hidden>
        <div class="gmd-mb" role="alertdialog" aria-modal="true" aria-labelledby="gmdMbT">
          <div class="gmd-mbbar"><span id="gmdMbT"></span><b aria-hidden="true">&#10005;</b></div>
          <div class="gmd-mbbody"><i id="gmdMbIcon"></i><p id="gmdMbText"></p></div>
          <div class="gmd-mbfoot" id="gmdMbBtns"></div>
        </div>
      </div>

      <!-- Notepad (the bake sheet and report open in it) -->
      <div class="gmd-over" id="gmdNp" hidden>
        <div class="gmd-np">
          <div class="gmd-npbar"><span id="gmdNpT"></span><button type="button" id="gmdNpX" aria-label="Close Notepad">&#10005;</button></div>
          <div class="gmd-npmenu"><span>File</span><span>Edit</span><span>View</span></div>
          <pre id="gmdNpText" data-lenis-prevent></pre>
          <div class="gmd-npstat"><span id="gmdNpPos">Ln 1, Col 1</span><span>100%</span><span>Windows (CRLF)</span><span>UTF-8 with BOM</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  /* ══════════════ data: the program's own sample data (seed_sample_data, generated on 2026-10-30) ══════════════ */
  const PRODUCTS: Record<string, number> = {
    'Pandesal': 5, 'Ensaymada': 25, 'Spanish Bread': 12, 'Cheese Bread': 15, 'Pan de Coco': 12,
    'Monay': 8, 'Cinnamon Roll': 35, 'Chocolate Cake (slice)': 60, 'Egg Pie (slice)': 40, 'Brownies': 30,
  };
  const P = Object.keys(PRODUCTS);
  const CUSTOMERS = ['Maria Santos', 'Juan Dela Cruz', 'Ana Reyes', 'Carlo Garcia', 'Liza Mendoza', 'Paolo Cruz', 'Grace Bautista', 'Mark Ramos', 'Joy Villanueva', 'Ben Aquino'];
  const CHART_COLORS = ['#175f27', '#63ab33', '#a8d27a', '#e9b44c', '#c8743a', '#8a5a3b', '#3b8ea5', '#7a6fb0', '#d9534f', '#8c9a8a'];
  /* customer digit, product digit, quantity, then the day relative to the day it was generated; c = Completed */
  const ORDERS_SRC = '097,-27c;1027,-27c;821,-27c;612,-27c;124,-27c;931,-27c;9017,-27c;9910,-27c;024,-27c;433,-27c;9013,-26c;2111,-26c;3028,-26c;129,-26c;3410,-26c;639,-26c;9524,-26c;486,-26c;313,-26c;8019,-26c;736,-26c;142,-25c;533,-25c;6025,-25c;1031,-25c;5528,-25c;926,-25c;138,-25c;198,-24c;4032,-24c;7531,-24c;517,-24c;5024,-24c;048,-23c;215,-23c;6522,-23c;188,-23c;8022,-23c;613,-23c;517,-22c;3522,-22c;2015,-22c;014,-22c;2310,-22c;211,-22c;926,-22c;843,-22c;0911,-22c;8811,-21c;627,-21c;6030,-21c;3012,-21c;522,-21c;042,-21c;149,-21c;0910,-21c;6710,-20c;5018,-20c;148,-20c;7025,-20c;135,-20c;5033,-20c;2525,-20c;834,-20c;0027,-19c;1519,-19c;8518,-19c;523,-19c;8527,-19c;3520,-19c;344,-19c;3612,-19c;5025,-19c;4510,-19c;9112,-18c;598,-18c;196,-18c;714,-18c;7016,-18c;0410,-18c;5311,-18c;162,-18c;3534,-17c;633,-17c;1520,-17c;6612,-17c;1312,-17c;2515,-17c;7028,-17c;963,-17c;5911,-16c;2027,-16c;1035,-16c;633,-16c;394,-16c;4016,-16c;5310,-16c;217,-16c;5033,-16c;8536,-15c;229,-15c;839,-15c;2024,-15c;243,-15c;1029,-15c;836,-15c;138,-15c;4016,-14c;8013,-14c;121,-14c;8210,-14c;444,-14c;729,-14c;834,-14c;875,-14c;774,-14c;727,-13c;3111,-13c;424,-13c;2538,-13c;5911,-13c;2038,-13c;194,-13c;228,-13c;294,-13c;597,-12c;526,-12c;0021,-12c;728,-12c;5522,-12c;835,-12c;392,-12c;192,-12c;211,-12c;613,-12c;4611,-12c;8039,-11c;5412,-11c;2011,-11c;422,-11c;1911,-11c;962,-11c;472,-11c;078,-11c;497,-10c;841,-10c;1540,-10c;095,-10c;4039,-10c;349,-10c;219,-10c;421,-9c;8010,-9c;834,-9c;138,-9c;6530,-9c;6527,-9c;395,-9c;2212,-8c;026,-8c;161,-8c;645,-8c;6012,-8c;4711,-8c;015,-7c;433,-7c;525,-7c;599,-7c;315,-7c;521,-7c;428,-7c;334,-7c;131,-7c;663,-6c;047,-6c;3111,-6c;8040,-6c;963,-6c;726,-6c;9033,-6c;841,-6c;8412,-6c;8026,-6c;961,-5c;3612,-5c;2011,-5c;642,-5c;069,-5c;8411,-5c;4525,-5c;1035,-5c;8526,-5c;1026,-5c;4525,-5c;365,-5c;7111,-4c;137,-4c;4311,-4c;3529,-4c;5014,-4c;4112,-4c;741,-3c;1018,-3c;7531,-3c;419,-3c;138,-3c;399,-3c;712,-3c;1024,-3c;468,-3c;114,-2c;843,-2c;216,-2c;8411,-2c;512,-2c;618,-2c;7010,-2c;4522,-2c;527,-1c;0020,-1c;616,-1c;3039,-1c;4538,-1c;612,-1c;5910,0p;485,0p;2036,0c;815,0c;016,0c;8611,0c;0312,0p;987,0c;7533,1p;2050,1p;5041,1p;416,1p;425,2p;6312,2p;1025,2p;8046,2p';
  const STOCK_SRC = '315,-20;710,-20;528,-20;48,-20;079,-20;614,-19;5100,-19;48,-19;052,-19;23,-19;921,-18;311,-18;67,-18;117,-18;416,-18;020,-18;319,-17;623,-17;574,-17;028,-17;915,-16;314,-16;115,-16;0111,-16;325,-15;544,-15;43,-15;055,-15;212,-15;34,-14;79,-14;44,-14;029,-14;220,-14;919,-13;112,-13;541,-13;039,-13;219,-13;914,-12;35,-12;611,-12;16,-12;527,-12;021,-12;214,-12;915,-11;710,-11;67,-11;412,-11;056,-11;22,-11;912,-10;113,-10;540,-10;417,-10;039,-10;96,-9;319,-9;561,-9;010,-9;21,-9;712,-8;61,-8;45,-8;019,-8;223,-8;99,-7;38,-7;114,-7;218,-7;610,-6;116,-6;428,-6;099,-6;26,-6;628,-5;576,-5;420,-5;073,-5;318,-4;124,-4;529,-4;022,-4;99,-3;38,-3;68,-3;111,-3;531,-3;44,-3;042,-3;120,-2;527,-2;414,-2;016,-2;18,-1;540,-1;064,-1;214,-1;910,0;316,0;616,0;812,0;112,0;036,0';

  /* ══════════════ helpers ══════════════ */
  type Order = { order_id: number; customer: string; product: string; quantity: number; price: number; order_date: string; status: string };
  type Stock = { entry_id: number; date: string; product: string; quantity: number };
  const pad = (n: number) => String(n).padStart(2, '0');
  const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const dayAt = (off: number) => { const d = new Date(); d.setHours(12, 0, 0, 0); d.setDate(d.getDate() + off); return iso(d); };
  const todayS = () => dayAt(0);
  const toDate = (s: string) => new Date(s + 'T12:00:00');
  const daysBetween = (a: string, b: string) => Math.round((toDate(a).getTime() - toDate(b).getTime()) / 864e5);
  const num = (n: number) => n.toLocaleString('en-US');
  const peso = (n: number) => '₱' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const plural = (n: number, w: string) => `${num(n)} ${w}${n === 1 ? '' : 's'}`;
  const total = (o: Order) => o.quantity * o.price;
  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const longDate = (s: string) => { const d = toDate(s); return `${DAYS[d.getDay()]}, ${pad(d.getDate())} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`; };
  const chipDate = (s: string) => { const d = toDate(s); return `${DAYS[d.getDay()].slice(0, 3)} ${pad(d.getDate())} ${MONTHS[d.getMonth()].slice(0, 3)}`; };
  /* parse_date: YYYY-MM-DD, or the formats Excel turns dates into */
  function parseDate(s: string): string | null {
    const t = s.trim();
    let m = t.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})$/), y = 0, mo = 0, d = 0;
    if (m) [y, mo, d] = [+m[1], +m[2], +m[3]];
    else if ((m = t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/))) [mo, d, y] = [+m[1], +m[2], +m[3]];
    else return null;
    const dt = new Date(y, mo - 1, d, 12);
    return dt.getFullYear() === y && dt.getMonth() === mo - 1 && dt.getDate() === d ? iso(dt) : null;
  }

  let orders: Order[] = ORDERS_SRC.split(';').map((s, i) => {
    const m = s.match(/^(\d)(\d)(\d+),(-?\d+)([cp])$/)!;
    const product = P[+m[2]];
    return { order_id: i + 1, customer: CUSTOMERS[+m[1]], product, quantity: +m[3], price: PRODUCTS[product], order_date: dayAt(+m[4]), status: m[5] === 'c' ? 'Completed' : 'Pending' };
  });
  let stock: Stock[] = STOCK_SRC.split(';').map((s, i) => {
    const m = s.match(/^(\d)(-?\d+),(-?\d+)$/)!;
    return { entry_id: i + 1, date: dayAt(+m[3]), product: P[+m[1]], quantity: +m[2] };
  });

  /* ══════════════ the program's calculations ══════════════ */
  function menuPrices() {
    const menu: Record<string, number> = { ...PRODUCTS };
    orders.slice().sort((a, b) => (a.order_date + String(a.order_id).padStart(6, '0') < b.order_date + String(b.order_id).padStart(6, '0') ? -1 : 1))
      .forEach(o => { if (!(o.product in PRODUCTS)) menu[o.product] = o.price; });
    return menu;
  }
  function dailyTotals() {
    const days = new Map<string, [number, number, number]>();
    orders.forEach(o => { const d = days.get(o.order_date) ?? [0, 0, 0]; d[0]++; d[1] += o.quantity; d[2] += total(o); days.set(o.order_date, d); });
    return new Map([...days.entries()].sort((a, b) => (a[0] < b[0] ? -1 : 1)));
  }
  function mostOrdered(): [string, number, number] | null {
    const count = new Map<string, number>(), pieces = new Map<string, number>();
    orders.forEach(o => { count.set(o.product, (count.get(o.product) ?? 0) + 1); pieces.set(o.product, (pieces.get(o.product) ?? 0) + o.quantity); });
    if (!count.size) return null;
    const top = [...count.keys()].reduce((a, b) => (count.get(b)! > count.get(a)! || (count.get(b) === count.get(a) && pieces.get(b)! > pieces.get(a)!) ? b : a));
    return [top, count.get(top)!, pieces.get(top)!];
  }
  function stockSummary(): [Record<string, { baked: number; sold: number; have: number; waiting: number; short: number }>, string | null] {
    const start = stock.length ? stock.map(e => e.date).sort()[0] : null;
    const baked: Record<string, number> = {}, sold: Record<string, number> = {}, waiting: Record<string, number> = {};
    stock.forEach(e => { baked[e.product] = (baked[e.product] ?? 0) + e.quantity; });
    orders.forEach(o => {
      if (o.status === 'Pending') waiting[o.product] = (waiting[o.product] ?? 0) + o.quantity;
      else if (start !== null && o.order_date >= start) sold[o.product] = (sold[o.product] ?? 0) + o.quantity;
    });
    const out: Record<string, { baked: number; sold: number; have: number; waiting: number; short: number }> = {};
    new Set([...Object.keys(baked), ...Object.keys(sold), ...Object.keys(waiting)]).forEach(p => {
      const have = (baked[p] ?? 0) - (sold[p] ?? 0);
      out[p] = { baked: baked[p] ?? 0, sold: sold[p] ?? 0, have, waiting: waiting[p] ?? 0, short: Math.max(0, (waiting[p] ?? 0) - Math.max(have, 0)) };
    });
    return [out, start];
  }

  /* ══════════════ UI plumbing ══════════════ */
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  type Col = { label: string; left?: boolean };
  function table(cols: Col[], rows: { cells: unknown[]; tag?: string; key?: string }[]) {
    const head = cols.map(c => `<th class="${c.left ? 'l' : ''}">${esc(c.label)}</th>`).join('');
    const body = rows.map((r, i) => `<tr class="${r.tag ?? (i % 2 ? 'odd' : 'even')}"${r.key ? ` data-key="${r.key}"` : ''}>${r.cells.map((v, j) => `<td class="${cols[j].left ? 'l' : ''}">${esc(v)}</td>`).join('')}</tr>`).join('');
    return `<div class="gmd-scroll"><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
  }
  const card = (title: string, value: string, note: string) => `<div class="gmd-card gmd-stat"><span>${esc(title)}</span><b>${esc(value)}</b><small>${esc(note)}</small></div>`;
  function segmented(id: string, onPick: (v: string) => void) {
    $(id).addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      $(id).querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
      onPick(b.textContent!.trim());
    });
  }
  const setSeg = (id: string, v: string) => $(id).querySelectorAll('button').forEach(x => x.classList.toggle('on', x.textContent!.trim() === v));

  /* tkinter.messagebox → a Windows message box */
  function messagebox(title: string, text: string, kind: 'info' | 'error' | 'question' | 'warning' = 'info', buttons = ['OK']): Promise<string> {
    $('gmdMbT').textContent = title;
    $('gmdMbText').textContent = text;
    $('gmdMbIcon').className = 'gmd-ic ' + kind;
    $('gmdMbIcon').textContent = { info: 'i', error: '✕', question: '?', warning: '!' }[kind];
