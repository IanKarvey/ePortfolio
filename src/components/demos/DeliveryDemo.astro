---
/* Failed Delivery Analyzer — browser recreation with the app's own sample records and rules.
   One engine, two views (GUI and terminal), exactly like the real program. */
---
<div class="dv" id="dv">
  <div class="dv-top">
    <div class="dv-switch" role="tablist" aria-label="Interface">
      <button type="button" class="on" data-view="gui" role="tab">Desktop app</button>
      <button type="button" data-view="term" role="tab">Terminal version</button>
    </div>
    <span class="dv-same">Same engine · same numbers</span>
  </div>

  <div class="dv-grid">
    <form class="dv-form" id="dvForm" novalidate>
      <div class="dv-h">Add delivery attempt</div>
      <label>Delivery ID
        <input id="dvId" list="dvIds" value="D006" maxlength="8" autocomplete="off">
        <datalist id="dvIds"></datalist>
        <small id="dvIdHint">New delivery</small>
      </label>
      <label>Area
        <select id="dvArea"><option>Area A</option><option>Area B</option><option>Area C</option></select>
      </label>
      <label>Final status
        <div class="dv-seg" id="dvStatus">
          <button type="button" data-v="Successful">Successful</button>
          <button type="button" data-v="Failed" class="on">Failed</button>
          <button type="button" data-v="Pending">Pending</button>
        </div>
      </label>
      <label>Failure reason
        <select id="dvReason">
          <option>Recipient unavailable</option><option>Incorrect address</option><option>Delivery postponed</option>
        </select>
      </label>
      <div class="dv-err" id="dvErr" role="alert"></div>
      <button type="submit" class="dv-btn">+ Add attempt <span id="dvAttempt">#1</span></button>
      <p class="dv-tip">Tip: re-use an ID like <button type="button" class="dv-link" data-id="D002">D002</button> to log a redelivery, or try <button type="button" class="dv-link" data-id="D001">D001</button> — it already succeeded.</p>
    </form>

    <div class="dv-out">
      <div class="dv-gui" id="dvGui">
        <div class="dv-tiles">
          <div><span>Success rate</span><b id="dvRate">0%</b></div>
          <div><span>Deliveries</span><b id="dvDel">0</b></div>
          <div><span>Needed redelivery</span><b id="dvRe">0</b></div>
          <div><span>Top failure</span><b id="dvTop" class="dv-sm">—</b></div>
        </div>
        <div class="dv-cols">
          <div>
            <div class="dv-h">Success rate by area</div>
            <div id="dvAreas" class="dv-bars"></div>
          </div>
          <div>
            <div class="dv-h">Failed attempts by reason</div>
            <div id="dvReasons" class="dv-bars"></div>
          </div>
        </div>
        <div class="dv-h">Records <span id="dvCount"></span></div>
        <div class="dv-table" data-lenis-prevent>
          <table><thead><tr><th>ID</th><th>Date</th><th>Area</th><th>#</th><th>Reason</th><th>Status</th></tr></thead><tbody id="dvRows"></tbody></table>
        </div>
      </div>
      <pre class="dv-term" id="dvTerm" hidden data-lenis-prevent></pre>
    </div>
  </div>
</div>

<script>
  type Rec = { id: string; date: string; area: string; n: number; reason: string; status: 'Successful' | 'Failed' | 'Pending'; fresh?: boolean };
  const NONE = 'None';
  const $ = (id: string) => document.getElementById(id)!;

  /* the program's own sample_data/delivery_records.csv */
  const recs: Rec[] = [
    { id: 'D001', date: '2026-10-01', area: 'Area A', n: 1, reason: 'Recipient unavailable', status: 'Failed' },
    { id: 'D001', date: '2026-10-02', area: 'Area A', n: 2, reason: NONE, status: 'Successful' },
    { id: 'D002', date: '2026-10-02', area: 'Area B', n: 1, reason: 'Incorrect address', status: 'Failed' },
    { id: 'D003', date: '2026-10-03', area: 'Area A', n: 1, reason: NONE, status: 'Successful' },
    { id: 'D004', date: '2026-10-04', area: 'Area C', n: 1, reason: 'Delivery postponed', status: 'Failed' },
    { id: 'D004', date: '2026-10-05', area: 'Area C', n: 2, reason: 'Recipient unavailable', status: 'Pending' },
    { id: 'D005', date: '2026-10-05', area: 'Area B', n: 1, reason: NONE, status: 'Successful' },
  ];
  let status: Rec['status'] = 'Failed';

  /* ── engine (mirrors delivery_core.py) ── */
  const byId = () => {
    const m = new Map<string, Rec[]>();
    recs.forEach(r => m.set(r.id, [...(m.get(r.id) ?? []), r]));
    m.forEach(list => list.sort((a, b) => a.n - b.n));
    return m;
  };
  const isFailure = (r: Rec) => r.status === 'Failed' || r.reason !== NONE;
  function analyse() {
    const ids = byId();
    const finals = [...ids.values()].map(l => l[l.length - 1]);
    const ok = finals.filter(r => r.status === 'Successful').length;
    const areas: Record<string, { total: number; ok: number }> = {};
    finals.forEach(r => { areas[r.area] ??= { total: 0, ok: 0 }; areas[r.area].total++; if (r.status === 'Successful') areas[r.area].ok++; });
    const reasons: Record<string, number> = {};
    recs.filter(isFailure).forEach(r => { if (r.reason !== NONE) reasons[r.reason] = (reasons[r.reason] || 0) + 1; });
    const top = Object.entries(reasons).sort((a, b) => b[1] - a[1])[0];
    return {
      deliveries: ids.size, ok, rate: ids.size ? (ok / ids.size) * 100 : 0,
      redelivered: [...ids.values()].filter(l => l.length > 1).length,
      failedAttempts: recs.filter(r => r.status === 'Failed').length,
      areas, reasons, top,
    };
  }
  /* validation rules from the real program */
  function validate(id: string, reason: string): string | null {
    if (!/^[A-Za-z0-9-]{1,8}$/.test(id)) return 'Delivery ID: use letters and numbers, like D006.';
    const prev = byId().get(id);
    if (prev?.some(r => r.status === 'Successful')) return `${id} already succeeded — a delivery that succeeded cannot get more attempts.`;
    if (status === 'Successful' && reason !== NONE) return 'A successful attempt has no failure reason.';
    if (status === 'Failed' && reason === NONE) return 'A failed attempt needs a failure reason.';
    return null;
  }

  /* ── form ── */
  const idIn = $('dvId') as HTMLInputElement;
  const areaSel = $('dvArea') as HTMLSelectElement;
  const reasonSel = $('dvReason') as HTMLSelectElement;
  function syncForm() {
    const id = idIn.value.trim().toUpperCase();
    const prev = byId().get(id);
    if (prev) {
      areaSel.value = prev[0].area; areaSel.disabled = true;
      const done = prev.some(r => r.status === 'Successful');
      $('dvIdHint').textContent = done ? `✓ ${id} already delivered` : `Redelivery — ${prev.length} earlier attempt${prev.length > 1 ? 's' : ''}, area filled in`;
      $('dvIdHint').className = done ? 'warn' : 'info';
      $('dvAttempt').textContent = `#${prev.length + 1}`;
    } else {
      areaSel.disabled = false;
      $('dvIdHint').textContent = 'New delivery'; $('dvIdHint').className = '';
      $('dvAttempt').textContent = '#1';
    }
    reasonSel.disabled = status === 'Successful';
    $('dvErr').textContent = '';
  }
  idIn.addEventListener('input', syncForm);
  $('dvStatus').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
    if (!b) return;
    status = b.dataset.v as Rec['status'];
    $('dvStatus').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    syncForm();
  });
  document.querySelectorAll<HTMLElement>('.dv-link').forEach(l => l.addEventListener('click', () => { idIn.value = l.dataset.id!; syncForm(); idIn.focus(); }));
  $('dvForm').addEventListener('submit', e => {
    e.preventDefault();
    const id = idIn.value.trim().toUpperCase();
    const reason = status === 'Successful' ? NONE : reasonSel.value;
    const err = validate(id, reason);
    if (err) { $('dvErr').textContent = err; return; }
    const prev = byId().get(id);
    const last = recs.map(r => r.date).sort().pop()!;
    const d = new Date(last); d.setDate(d.getDate() + (prev ? 1 : 0));
    recs.push({ id, date: d.toISOString().slice(0, 10), area: prev ? prev[0].area : areaSel.value, n: (prev?.length ?? 0) + 1, reason, status, fresh: true });
    if (!prev) idIn.value = 'D' + String(byId().size + 1).padStart(3, '0');
    syncForm();
    render();
  });

  /* ── views ── */
  function bars(el: HTMLElement, rows: [string, number, string][], max: number, worst?: string) {
    el.innerHTML = '';
    rows.forEach(([label, v, text]) => {
      const r = document.createElement('div');
      r.className = 'dv-bar' + (label === worst ? ' worst' : '');
      r.innerHTML = '<span></span><div><i></i></div><b></b>';
      r.querySelector('span')!.textContent = label + (label === worst ? ' ▼' : '');
      r.querySelector('b')!.textContent = text;
      el.appendChild(r);
      requestAnimationFrame(() => requestAnimationFrame(() => { (r.querySelector('i') as HTMLElement).style.width = (max ? (v / max) * 100 : 0) + '%'; }));
    });
  }
  function render() {
    const a = analyse();
    $('dvRate').textContent = a.rate.toFixed(1) + '%';
    $('dvDel').textContent = String(a.deliveries);
    $('dvRe').textContent = String(a.redelivered);
    $('dvTop').textContent = a.top ? a.top[0] : '—';
    const areaRows = Object.entries(a.areas).sort().map(([k, v]) => [k, (v.ok / v.total) * 100, `${Math.round((v.ok / v.total) * 100)}%`] as [string, number, string]);
    const worst = areaRows.slice().sort((x, y) => x[1] - y[1])[0]?.[0];
    bars($('dvAreas'), areaRows, 100, worst);
    const rs = Object.entries(a.reasons).sort((x, y) => y[1] - x[1]);
    bars($('dvReasons'), rs.map(([k, v]) => [k, v, String(v)]), Math.max(...rs.map(x => x[1]), 1));
    $('dvCount').textContent = `${recs.length} attempts · saved to delivery_records.csv`;
    const body = $('dvRows');
    body.innerHTML = '';
    recs.slice().reverse().forEach(r => {
      const tr = document.createElement('tr');
      tr.className = r.status.toLowerCase() + (r.fresh ? ' fresh' : '');
      [r.id, r.date, r.area, String(r.n), r.reason, r.status].forEach(t => { const td = document.createElement('td'); td.textContent = t; tr.appendChild(td); });
      body.appendChild(tr);
      r.fresh = false;
    });
    /* the terminal version prints the same analysis — menu option 10, Delivery Summary */
    const pad = (s: string, n: number) => s.padEnd(n);
    const lines = [
      '='.repeat(56),
      '  FAILED DELIVERY AND REDELIVERY PATTERN ANALYZER',
      '='.repeat(56),
      '  10. Delivery Summary',
      '-'.repeat(56),
      `  ${pad('Total delivery attempts', 34)}${recs.length}`,
      `  ${pad('Successful deliveries', 34)}${a.ok}`,
      `  ${pad('Failed attempts', 34)}${a.failedAttempts}`,
      `  ${pad('Deliveries requiring redelivery', 34)}${a.redelivered}`,
      `  ${pad('Most common failure reason', 34)}${a.top ? a.top[0] : '-'}`,
      `  ${pad('Delivery success rate', 34)}${a.rate.toFixed(1)}%`,
      '',
      '  Success rate by area',
      ...areaRows.map(([k, v]) => `    ${pad(k, 10)}${'█'.repeat(Math.round(v / 5)).padEnd(20, '░')} ${v.toFixed(0).padStart(3)}%${k === worst ? '   <- lowest' : ''}`),
      '',
      '  Failure reasons',
      ...rs.map(([k, v]) => `    ${pad(k, 24)}${'■'.repeat(v)} ${v}`),
      '-'.repeat(56),
      '  Press Enter to return to the menu...',
    ];
    $('dvTerm').textContent = lines.join('\n');
  }

  document.querySelectorAll<HTMLElement>('#dv [data-view]').forEach(b => b.addEventListener('click', () => {
    const term = b.dataset.view === 'term';
    document.querySelectorAll('#dv [data-view]').forEach(x => x.classList.toggle('on', x === b));
    $('dvGui').hidden = term;
    $('dvTerm').hidden = !term;
  }));

  $('dvIds').innerHTML = [...new Set(recs.map(r => r.id))].map(i => `<option value="${i}">`).join('');
  syncForm();
  render();
</script>

<style is:global>
  .dv{border:.7px solid var(--brd2);border-radius:8px;background:var(--bg);overflow:hidden}
  .dv-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 16px;border-bottom:.6px solid var(--brd)}
  .dv-switch{display:flex;padding:3px;border:.6px solid var(--brd2);border-radius:4px}
  .dv-switch button{height:30px;padding:0 14px;border:none;border-radius:2px;background:none;color:var(--fg3);font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
  .dv-switch button.on{background:var(--accent);color:#14110d}
  .dv-same{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--fg3)}
  .dv-grid{display:grid;grid-template-columns:290px 1fr}
  .dv-form{display:flex;flex-direction:column;gap:14px;padding:18px;border-right:.6px solid var(--brd);background:var(--bg2)}
  .dv-h{display:flex;justify-content:space-between;gap:8px;font-family:var(--mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--fg2);margin-bottom:10px}
  .dv-h span{color:var(--fg3);letter-spacing:.04em;text-transform:none}
  .dv-form label{display:flex;flex-direction:column;gap:6px;font-family:var(--sans);font-size:11px;color:var(--fg3)}
  .dv-form input,.dv-form select{height:38px;padding:0 11px;border-radius:3px;border:.6px solid var(--brd2);background:var(--bg);color:var(--fg);font-family:var(--mono);font-size:12.5px}
  .dv-form input:focus,.dv-form select:focus{outline:none;border-color:var(--accent)}
  .dv-form select:disabled{opacity:.45}
  .dv-form small{font-family:var(--mono);font-size:9.5px;color:var(--fg3)}
  .dv-form small.info{color:var(--accent)}
  .dv-form small.warn{color:#f0a59d}
  .dv-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
  .dv-seg button{height:34px;border-radius:3px;border:.6px solid var(--brd2);background:var(--bg);color:var(--fg3);font-family:var(--sans);font-size:11px;cursor:pointer}
  .dv-seg button.on[data-v="Successful"]{background:rgba(111,207,127,.14);border-color:#6fcf7f;color:#8fe39e}
  .dv-seg button.on[data-v="Failed"]{background:rgba(224,87,75,.14);border-color:#e0574b;color:#f0a59d}
  .dv-seg button.on[data-v="Pending"]{background:rgba(240,180,76,.14);border-color:#f0b44c;color:#f6cd84}
  .dv-err{min-height:0;font-family:var(--sans);font-size:12px;color:#f0a59d;line-height:1.5}
  .dv-err:empty{display:none}
  .dv-btn{height:42px;border:none;border-radius:3px;background:var(--accent);color:#14110d;font-family:var(--sans);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
  .dv-btn:hover{filter:brightness(1.08)}
  .dv-tip{font-family:var(--sans);font-size:11.5px;font-weight:300;line-height:1.6;color:var(--fg3)}
  .dv-link{background:none;border:none;padding:0;font-family:var(--mono);font-size:11px;color:var(--accent);text-decoration:underline dotted;text-underline-offset:3px;cursor:pointer}
  .dv-out{padding:18px;min-width:0}
  .dv-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--brd);border:.6px solid var(--brd);margin-bottom:20px}
  .dv-tiles div{background:var(--bg);padding:14px;display:flex;flex-direction:column;gap:6px;min-width:0}
  .dv-tiles span{font-family:var(--mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:var(--fg3)}
  .dv-tiles b{font-family:var(--serif);font-weight:900;font-size:28px;color:var(--accent);line-height:1}
  .dv-tiles b.dv-sm{font-family:var(--sans);font-size:13px;font-weight:400;color:var(--fg);line-height:1.3}
  .dv-cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
  .dv-bars{display:flex;flex-direction:column;gap:8px}
  .dv-bar{display:grid;grid-template-columns:minmax(80px,140px) 1fr 40px;gap:10px;align-items:center;font-family:var(--sans);font-size:11.5px;color:var(--fg2)}
  .dv-bar div{height:10px;background:var(--bg3);border-radius:2px;overflow:hidden}
  .dv-bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .8s cubic-bezier(.25,1,.5,1)}
  .dv-bar.worst span{color:#f0a59d}
  .dv-bar.worst i{background:#e0574b}
  .dv-bar b{font-family:var(--mono);font-size:10.5px;font-weight:400;text-align:right;color:var(--fg)}
  .dv-table{max-height:230px;overflow:auto;border:.6px solid var(--brd)}
  .dv table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:11px}
  .dv th{position:sticky;top:0;text-align:left;padding:8px 10px;background:var(--bg3);color:var(--fg3);font-weight:400;font-size:9px;letter-spacing:.1em;text-transform:uppercase}
  .dv td{padding:7px 10px;border-top:.6px solid var(--brd);color:var(--fg2);white-space:nowrap}
  .dv tr.successful td:last-child{color:#8fe39e}
  .dv tr.failed td:last-child{color:#f0a59d}
  .dv tr.pending td:last-child{color:#f6cd84}
  .dv tr.fresh td{animation:dvFresh 1.6s ease-out}
  @keyframes dvFresh{from{background:color-mix(in srgb,var(--accent) 22%,transparent)}}
  .dv-term{margin:0;min-height:420px;max-height:520px;overflow:auto;padding:18px;background:#0a0907;border:.6px solid var(--brd);border-radius:4px;font-family:var(--mono);font-size:11.5px;line-height:1.6;color:#d8cfbf;white-space:pre}
  html:not(.touch) .dv button,html:not(.touch) .dv select{cursor:none}
  @media(max-width:860px){
    .dv-grid{grid-template-columns:1fr}
    .dv-form{border-right:none;border-bottom:.6px solid var(--brd)}
    .dv-tiles{grid-template-columns:repeat(2,1fr)}
    .dv-cols{grid-template-columns:1fr}
  }
</style>
