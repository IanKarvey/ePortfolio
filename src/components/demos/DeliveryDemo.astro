---
/* Failed Delivery Analyzer — the real program's window, rebuilt for the browser.
   Same palette, layout, wording, rules and numbers as delivery_gui.py / delivery_core.py,
   plus the console version (delivery_console.py) running on the same records. */
---
<div class="fda" id="fda">
  <div class="fda-mode" role="tablist" aria-label="Version">
    <button type="button" class="on" data-mode="gui" role="tab" aria-selected="true">Desktop app</button>
    <button type="button" data-mode="con" role="tab" aria-selected="false">Terminal version</button>
    <span>Same engine · same records</span>
  </div>

  <!-- ═══ the desktop window ═══ -->
  <div class="fda-win" id="fdaWin">
    <div class="fda-bar">
      <img src="/projects/delivery-app-icon.png" alt="" width="16" height="16">
      <span>Failed Delivery and Redelivery Pattern Analyzer</span>
      <i class="fda-caps" aria-hidden="true"><b>&#8212;</b><b>&#9633;</b><b>&#10005;</b></i>
    </div>

    <div class="fda-app" data-lenis-prevent>
      <header class="fda-top">
        <div class="fda-brand">
          <img src="/projects/delivery-app-icon.png" alt="Delivery Analyzer logo" width="42" height="42">
          <div><b>Delivery Analyzer</b><small>Pattern analyzer</small></div>
        </div>
        <nav class="fda-tabs" role="tablist" aria-label="Pages">
          <button type="button" class="on" data-page="0" role="tab"><i>&#9776;</i>Records</button>
          <button type="button" data-page="1" role="tab"><i>&#8635;</i>Redelivery Tracking</button>
          <button type="button" data-page="2" role="tab"><i>&#9684;</i>Analysis</button>
          <button type="button" data-page="3" role="tab"><i>&#9637;</i>Charts</button>
        </nav>
        <div class="fda-file"><span>delivery_records.csv</span><span id="fdaFile"></span></div>
      </header>

      <!-- Records -->
      <section class="fda-page on" data-page="0">
        <div class="fda-head">
          <div><h3>Records</h3><p>Add, view, search, update and filter delivery records. One row per delivery attempt; a redelivery is a new row with the same Delivery ID.</p></div>
          <div class="fda-actions">
            <button type="button" class="fda-pill" id="fdaAdd">+&nbsp; Add delivery</button>
            <button type="button" class="fda-pill fda-pill-2" id="fdaEdit" disabled>Edit</button>
          </div>
        </div>
        <div class="fda-tiles4" id="fdaRecTiles"></div>
        <div class="fda-card fda-filters">
          <label>Search Delivery ID<input id="fdaQ" class="fda-soft" autocomplete="off" spellcheck="false"></label>
          <label>Area<select id="fdaFArea" class="fda-soft"></select></label>
          <label>Status<select id="fdaFStatus" class="fda-soft"><option value="">All statuses</option><option>Successful</option><option>Failed</option><option>Pending</option></select></label>
          <label>Failure reason<select id="fdaFReason" class="fda-soft"></select></label>
          <label>Attempts per delivery<select id="fdaFAtt" class="fda-soft"><option value="">Any attempts</option><option value="1">1</option><option value="2">2</option><option value="3+">3+</option></select></label>
          <button type="button" class="fda-pill fda-pill-o" id="fdaClear">Clear filters</button>
        </div>
        <div class="fda-card fda-tablecard"><div class="fda-scroll" id="fdaRecTable"></div></div>
        <p class="fda-foot" id="fdaShowing"></p>
      </section>

      <!-- Redelivery Tracking -->
      <section class="fda-page" data-page="1">
        <div class="fda-head"><div><h3>Redelivery Tracking</h3><p>How many attempts each delivery needed, and what happened on every attempt.</p></div></div>
        <div class="fda-card fda-row">
          <label class="fda-check"><input type="checkbox" id="fdaOnlyRe" checked> Show only deliveries that needed more than one attempt</label>
          <b class="fda-accent" id="fdaReSum"></b>
        </div>
        <div class="fda-card fda-tablecard"><div class="fda-scroll" id="fdaTrTable"></div></div>
        <h4>Attempt history</h4>
        <div class="fda-card fda-tablecard"><div class="fda-scroll" id="fdaHist"></div></div>
      </section>

      <!-- Analysis -->
      <section class="fda-page" data-page="2">
        <div class="fda-head"><div><h3>Analysis</h3><p>Failed delivery analysis, delivery success rate, area-based analysis and the delivery summary, from the saved records.</p></div></div>
        <div class="fda-tiles8" id="fdaAnTiles"></div>
        <div class="fda-banner" id="fdaBanner"></div>
        <div class="fda-two">
          <div><h4>Delivery success rate by area</h4><div class="fda-card fda-tablecard"><div class="fda-scroll" id="fdaAreaT"></div></div></div>
          <div><h4>Failure reasons</h4><div class="fda-card fda-tablecard"><div class="fda-scroll" id="fdaReasonT"></div></div></div>
        </div>
      </section>

      <!-- Charts -->
      <section class="fda-page" data-page="3">
        <div class="fda-head"><div><h3>Charts</h3><p>Data visualization with Matplotlib: failed deliveries by reason, delivery success rate by area, redelivery trends and delivery status.</p></div></div>
        <div class="fda-chartbtns" id="fdaChartBtns">
          <button type="button" class="on" data-chart="reasons">Failed Deliveries by Reason</button>
          <button type="button" data-chart="areas">Delivery Success Rate by Area</button>
          <button type="button" data-chart="trends">Redelivery Trends</button>
          <button type="button" data-chart="status">Delivery Status</button>
        </div>
        <div class="fda-card fda-chart" id="fdaChart"></div>
      </section>

      <div class="fda-toast" id="fdaToast" aria-live="polite"></div>

      <!-- Add / Edit dialog (RecordDialog) -->
      <div class="fda-modal" id="fdaModal" hidden>
        <form class="fda-dialog" id="fdaDialog" novalidate>
          <h5 id="fdaDlgTitle">Add delivery record</h5>
          <p>One row = one delivery attempt. A redelivery is a new attempt of the same Delivery ID.</p>
          <div class="fda-fields">
            <b>Delivery ID</b><div><input id="fdId" class="fda-soft" autocomplete="off" spellcheck="false"></div><small data-note="id"></small>
            <b>Delivery Date</b><div class="fda-daterow"><input id="fdDate" class="fda-soft" autocomplete="off"><button type="button" class="fda-pill fda-pill-o fda-pill-s" id="fdCal">Calendar</button><input type="date" id="fdPick" tabindex="-1" aria-hidden="true"></div><small data-note="date"></small>
            <b>Delivery Area</b><div><input id="fdArea" class="fda-soft fda-combo" list="fdAreas" autocomplete="off"><datalist id="fdAreas"></datalist></div><small data-note="area"></small>
            <b>Attempt Number</b><div><input id="fdAtt" class="fda-soft fda-spin" type="number" min="1" max="99"></div><small data-note="attempt"></small>
            <b>Final Status</b><div><select id="fdStatus" class="fda-soft"><option>Successful</option><option>Failed</option><option>Pending</option></select></div><small data-note="status"></small>
            <b>Failure Reason</b><div id="fdReasonWrap"><input id="fdReason" class="fda-soft fda-combo" list="fdReasons" autocomplete="off"><datalist id="fdReasons"></datalist></div><small data-note="reason"></small>
          </div>
          <div class="fda-hint" id="fdHint"></div>
          <div class="fda-btns">
            <button type="button" class="fda-pill fda-pill-o" id="fdCancel">Cancel</button>
            <button type="submit" class="fda-pill">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ═══ the console version ═══ -->
  <div class="fda-con" id="fdaCon" hidden>
    <div class="fda-conbar"><span class="fda-conicon" aria-hidden="true">&gt;_</span><span>C:\WINDOWS\system32\cmd.exe</span><i class="fda-caps" aria-hidden="true"><b>&#8212;</b><b>&#9633;</b><b>&#10005;</b></i></div>
    <pre class="fda-term" id="fdaTerm" data-lenis-prevent></pre>
    <div class="fda-fig" id="fdaFig" hidden>
      <div class="fda-figwin">
        <div class="fda-bar fda-figbar"><span id="fdaFigTitle">Figure 1</span><button type="button" class="fda-figx" id="fdaFigClose" aria-label="Close the chart window">&#10005;</button></div>
        <div class="fda-figbody" id="fdaFigBody"></div>
      </div>
    </div>
  </div>
</div>

<script>
  /* ══════════════ engine: a line-for-line port of delivery_core.py ══════════════ */
  type Rec = { id: string; day: string; area: string; attempt: number; reason: string; status: string };
  const SUCCESSFUL = 'Successful', FAILED = 'Failed', PENDING = 'Pending';
  const STATUSES = [SUCCESSFUL, FAILED, PENDING];
  const NO_REASON = 'None', NOT_SPECIFIED = 'Not specified';
  const COMMON_REASONS = ['Recipient unavailable', 'Incorrect address', 'Delivery postponed'];
  const FIELDS = ['Delivery ID', 'Delivery Date', 'Delivery Area', 'Attempt Number', 'Failure Reason', 'Final Status'];

  /* sample_data/delivery_records.csv, as shipped with the program */
  const records: Rec[] = [
    { id: 'D001', day: '2026-10-01', area: 'Area A', attempt: 1, reason: 'Recipient unavailable', status: FAILED },
    { id: 'D001', day: '2026-10-02', area: 'Area A', attempt: 2, reason: NO_REASON, status: SUCCESSFUL },
    { id: 'D002', day: '2026-10-02', area: 'Area B', attempt: 1, reason: 'Incorrect address', status: FAILED },
    { id: 'D003', day: '2026-10-03', area: 'Area A', attempt: 1, reason: NO_REASON, status: SUCCESSFUL },
    { id: 'D004', day: '2026-10-04', area: 'Area C', attempt: 1, reason: 'Delivery postponed', status: FAILED },
    { id: 'D004', day: '2026-10-05', area: 'Area C', attempt: 2, reason: 'Recipient unavailable', status: PENDING },
    { id: 'D005', day: '2026-10-05', area: 'Area B', attempt: 1, reason: NO_REASON, status: SUCCESSFUL },
  ];

  const clean = (t: unknown) => String(t ?? '').split(/\s+/).filter(Boolean).join(' ');
  const plural = (n: number, w: string) => n === 1 ? `${n} ${w}` : `${n} ${w.endsWith('y') ? w.slice(0, -1) + 'ies' : w + 's'}`;
  const fmtPct = (v: number) => v.toFixed(1).replace(/0+$/, '').replace(/\.$/, '') + '%';
  const percent = (p: number, w: number) => (w ? (100 * p) / w : 0);
  const matchCase = (v: string, opts: string[]) => opts.find(o => o.toLowerCase() === v.toLowerCase()) ?? v;
  const isFailedAttempt = (r: Rec) => r.status === FAILED || r.reason !== NO_REASON;
  const reasonLabel = (r: Rec) => (r.reason !== NO_REASON ? r.reason : NOT_SPECIFIED);
  const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  const isDate = (t: string) => /^\d{4}-\d{2}-\d{2}$/.test(t) && !isNaN(Date.parse(t + 'T00:00:00Z')) && new Date(t + 'T00:00:00Z').toISOString().startsWith(t);
  const cmp = (a: string | number, b: string | number) => (a < b ? -1 : a > b ? 1 : 0);

  const attemptsOf = (id: string) => records.filter(r => r.id === id.trim().toUpperCase()).sort((a, b) => cmp(a.attempt, b.attempt) || cmp(a.day, b.day));
  const nextAttempt = (id: string) => Math.max(0, ...attemptsOf(id).map(r => r.attempt)) + 1;
  const knownAreas = () => [...new Set(records.map(r => r.area))].sort();
  const knownReasons = () => [...COMMON_REASONS, ...[...new Set(records.filter(r => r.reason !== NO_REASON).map(r => r.reason))].filter(r => !COMMON_REASONS.includes(r)).sort()];
  const sortRecords = (rs: Rec[]) => rs.slice().sort((a, b) => cmp(a.day, b.day) || cmp(a.id, b.id) || cmp(a.attempt, b.attempt));

  function groupDeliveries(rs: Rec[]) {
    const g = new Map<string, Rec[]>();
    rs.forEach(r => g.set(r.id, [...(g.get(r.id) ?? []), r]));
    g.forEach(l => l.sort((a, b) => cmp(a.attempt, b.attempt) || cmp(a.day, b.day)));
    return g;
  }
  type Info = { id: string; area: string; attempts: number; status: string; first: string; last: string; lastReason: string };
  function deliveryInfos(rs: Rec[]): Info[] {
    return [...groupDeliveries(rs).entries()].sort((a, b) => cmp(a[0], b[0])).map(([id, at]) => {
      const last = at[at.length - 1], days = at.map(a => a.day).sort();
      return { id, area: last.area, attempts: at.length, status: last.status, first: days[0], last: days[days.length - 1], lastReason: last.reason };
    });
  }
  function failedByReason(rs: Rec[]): [string, number][] {
    const c = new Map<string, number>();
    rs.filter(isFailedAttempt).forEach(r => c.set(reasonLabel(r), (c.get(reasonLabel(r)) ?? 0) + 1));
    return [...c.entries()].sort((a, b) => b[1] - a[1] || cmp(a[0], b[0]));
  }
  function summarize(rs: Rec[]) {
    const infos = deliveryInfos(rs), reasons = failedByReason(rs);
    const n = (s: string) => infos.filter(i => i.status === s).length;
    let top = '-';
    if (reasons.length) { const t = reasons[0][1]; top = `${reasons.filter(r => r[1] === t).map(r => r[0]).join(' / ')} (${t})`; }
    return {
      total: rs.length, deliveries: infos.length, successful: n(SUCCESSFUL), failed: n(FAILED), pending: n(PENDING),
      redeliveries: infos.filter(i => i.attempts > 1).length, failedAttempts: reasons.reduce((s, r) => s + r[1], 0),
      rate: percent(n(SUCCESSFUL), infos.length), top,
    };
  }
  function successByArea(rs: Rec[]) {
    const infos = deliveryInfos(rs);
    return [...new Set(infos.map(i => i.area))].sort().map(area => {
      const mine = infos.filter(i => i.area === area), ok = mine.filter(i => i.status === SUCCESSFUL).length;
      return { area, deliveries: mine.length, successful: ok, redeliveries: mine.filter(i => i.attempts > 1).length, rate: percent(ok, mine.length) };
    });
  }
  function trend(rs: Rec[]) {
    if (!rs.length) return [] as { day: string; failed: number; re: number }[];
    const days = rs.map(r => r.day).sort(), out = [];
    for (let d = new Date(days[0] + 'T00:00:00'); ; d.setDate(d.getDate() + 1)) {
      const k = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      out.push({ day: k, failed: rs.filter(r => r.day === k && isFailedAttempt(r)).length, re: rs.filter(r => r.day === k && r.attempt >= 2).length });
      if (k >= days[days.length - 1]) break;
    }
    return out;
  }
  function filterRecords(rs: Rec[], text = '', area = '', status = '', reason = '', attempts = '') {
    const totals = new Map<string, number>();
    rs.forEach(r => totals.set(r.id, (totals.get(r.id) ?? 0) + 1));
    const q = clean(text).toLowerCase();
    return rs.filter(r => {
      if (q && !r.id.toLowerCase().includes(q)) return false;
      if (area && r.area !== area) return false;
      if (status && r.status !== status) return false;
      if (reason && r.reason !== reason) return false;
      if (attempts) { const t = totals.get(r.id)!; if ((attempts === '3+' && t < 3) || (attempts !== '3+' && t !== +attempts)) return false; }
      return true;
    });
  }
  function problems(rec: Rec, rs: Rec[], editing: Rec | null): [string, string][] {
    const f: [string, string][] = [];
    if (!rec.id) f.push(['id', 'Delivery ID is required.']);
    if (!rec.area) f.push(['area', 'Delivery area is required.']);
    if (rec.attempt < 1) f.push(['attempt', 'Attempt number must be 1 or more.']);
    if (!STATUSES.includes(rec.status)) f.push(['status', 'Choose a final status: ' + STATUSES.join(', ') + '.']);
    else if (rec.status === SUCCESSFUL && rec.reason !== NO_REASON) f.push(['reason', 'A successful attempt cannot have a failure reason (use None).']);
    else if (rec.status === FAILED && rec.reason === NO_REASON) f.push(['reason', 'A failed attempt needs a failure reason.']);
    const same = rs.filter(r => r !== editing && r.id === rec.id);
    if (same.some(r => r.attempt === rec.attempt)) f.push(['attempt', `${rec.id} already has an attempt number ${rec.attempt}.`]);
    if (!editing) {
      const done = same.filter(r => r.status === SUCCESSFUL);
      if (done.length) f.push(['id', `${rec.id} was already delivered successfully (attempt ${done[0].attempt}), so no more attempts can be added.`]);
    }
    return f;
  }
  class ValidationError { constructor(public errors: string[], public fields: Record<string, string>) {} }
  /* make_attempt + DeliveryStore.add/update: raw text in, a saved record out (or ValidationError) */
  function save(idT: string, dayT: string, areaT: string, attT: string, reasonT: string, statusT: string, editing: Rec | null): Rec {
    const errors: string[] = [], fields: Record<string, string> = {};
    let reason = clean(reasonT) || NO_REASON;
    if (reason.toLowerCase() === 'none') reason = NO_REASON;
    const day = clean(dayT);
    if (!isDate(day)) { errors.push('Date must use the format YYYY-MM-DD (example: 2026-10-01).'); fields.date = errors[errors.length - 1]; }
    const n = /^-?\d+$/.test(clean(attT)) ? parseInt(clean(attT), 10) : NaN;
    if (isNaN(n)) { errors.push('Attempt number must be a whole number.'); fields.attempt = errors[errors.length - 1]; }
    const rec: Rec = {
      id: clean(idT).toUpperCase(), day: isDate(day) ? day : today(), area: matchCase(clean(areaT), knownAreas()),
      attempt: isNaN(n) ? 1 : n, reason: matchCase(reason, [...knownReasons(), NO_REASON]), status: matchCase(clean(statusT), STATUSES),
    };
    for (const [field, text] of problems(rec, records, editing)) {
      if (!(field in fields)) { errors.push(text); fields[field] = text; }
    }
    if (errors.length) throw new ValidationError(errors, fields);
    if (editing) records.splice(records.indexOf(editing), 1, rec); else records.push(rec);
    return rec;
  }

  /* ══════════════ desktop window ══════════════ */
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const TINT: Record<string, string> = { Failed: 'fail', Pending: 'pend', Successful: '' };
  type Col = { label: string; align?: 'c' | 'r'; w?: string };
  function table(cols: Col[], rows: { cells: unknown[]; cls?: string; key?: string }[], empty = '') {
    const head = cols.map(c => `<th class="${c.align ?? ''}"${c.w ? ` style="width:${c.w}"` : ''}>${esc(c.label)}</th>`).join('');
    const body = rows.length
      ? rows.map(r => `<tr class="${r.cls ?? ''}"${r.key ? ` data-key="${r.key}"` : ''}>${r.cells.map((v, i) => `<td class="${cols[i].align ?? ''}">${esc(v)}</td>`).join('')}</tr>`).join('')
      : `<tr class="empty"><td colspan="${cols.length}">${esc(empty)}</td></tr>`;
    return `<table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
  }

  let page = 0, selected: Rec | null = null, trackSel: string | null = null, chartKey = 'reasons';
  let sortCol = 1, sortAsc = true;

  function fillFilterOptions() {
    const keep = (sel: HTMLSelectElement, first: string, values: string[]) => {
      const v = sel.value;
      sel.innerHTML = `<option value="">${first}</option>` + values.map(x => `<option>${esc(x)}</option>`).join('');
      sel.value = values.includes(v) ? v : '';
    };
    keep($('fdaFArea'), 'All areas', knownAreas());
    keep($('fdaFReason'), 'All reasons', [NO_REASON, ...knownReasons()]);
  }
  const tile = (label: string, value: string) => `<div class="fda-card fda-tile"><span>${esc(label)}</span><b>${esc(value)}</b></div>`;

  function renderRecords() {
    const s = summarize(records);
    $('fdaRecTiles').innerHTML = tile('Total delivery attempts', String(s.total)) + tile('Unique deliveries', String(s.deliveries))
      + tile('Failed delivery attempts', String(s.failedAttempts)) + tile('Delivery success rate', fmtPct(s.rate));
    const found = filterRecords(records, $<HTMLInputElement>('fdaQ').value, $<HTMLSelectElement>('fdaFArea').value,
      $<HTMLSelectElement>('fdaFStatus').value, $<HTMLSelectElement>('fdaFReason').value, $<HTMLSelectElement>('fdaFAtt').value);
    const keyOf = (r: Rec) => [r.id, r.day, r.area, r.attempt, r.reason, r.status][sortCol];
    const rows = sortRecords(found).sort((a, b) => (sortAsc ? 1 : -1) * cmp(keyOf(a), keyOf(b)));
    const cols: Col[] = FIELDS.map((f, i) => ({ label: f + (i === sortCol ? (sortAsc ? ' ▲' : ' ▼') : ''), align: i === 3 ? 'c' : undefined }));
    $('fdaRecTable').innerHTML = table(cols, rows.map(r => ({
      cells: [r.id, r.day, r.area, r.attempt, r.reason, r.status],
      cls: (r === selected ? 'sel ' : '') + TINT[r.status], key: String(records.indexOf(r)),
    })), 'No delivery attempts match these filters.');
    $('fdaShowing').textContent = `Showing ${found.length} of ${plural(records.length, 'delivery attempt')}`;
    ($('fdaEdit') as HTMLButtonElement).disabled = !selected;
  }

  function renderTracking() {
    const infos = deliveryInfos(records), again = infos.filter(i => i.attempts > 1);
    const only = $<HTMLInputElement>('fdaOnlyRe').checked;
    const shown = only ? again.slice().sort((a, b) => b.attempts - a.attempts || cmp(a.id, b.id)) : infos;
    $('fdaReSum').textContent = `${again.length} of ${plural(infos.length, 'delivery')} needed redelivery (${fmtPct(percent(again.length, infos.length))})`;
    $('fdaTrTable').innerHTML = table(
      [{ label: 'Delivery ID' }, { label: 'Area' }, { label: 'Attempts', align: 'c' }, { label: 'First attempt' }, { label: 'Latest attempt' }, { label: 'Latest status' }, { label: 'Latest failure reason' }],
      shown.map(i => ({ cells: [i.id, i.area, i.attempts, i.first, i.last, i.status, i.lastReason], cls: (i.id === trackSel ? 'sel ' : '') + TINT[i.status], key: i.id })),
      only ? 'No delivery has needed a second attempt yet.' : 'No records yet.');
    const hist = trackSel ? attemptsOf(trackSel) : [];
    $('fdaHist').innerHTML = table(
      [{ label: 'Attempt Number', align: 'c' }, { label: 'Delivery Date' }, { label: 'Failure Reason' }, { label: 'Final Status', align: 'c' }],
      hist.map(r => ({ cells: [r.attempt, r.day, r.reason, r.status], cls: TINT[r.status] })),
      'Select a delivery above to see its attempts.');
  }

  function renderAnalysis() {
    const s = summarize(records);
    const t = (title: string, value: string, hint: string, dot = '') =>
      `<div class="fda-card fda-tile fda-tile8${dot ? ' dot' : ''}"><span>${dot ? `<i style="background:${dot}"></i>` : ''}${esc(title)}</span><b>${esc(value)}</b><small>${esc(hint)}</small></div>`;
    $('fdaAnTiles').innerHTML =
      t('Total delivery attempts', String(s.total), 'all rows in the file') + t('Unique deliveries', String(s.deliveries), 'distinct delivery IDs')
      + t('Successful deliveries', String(s.successful), 'latest attempt succeeded', '#0ca30c') + t('Failed deliveries', String(s.failed), 'latest attempt failed', '#d03b3b')
      + t('Pending deliveries', String(s.pending), 'waiting for an outcome', '#fab219') + t('Requiring redelivery', String(s.redeliveries), 'deliveries with 2+ attempts')
      + t('Failed delivery attempts', String(s.failedAttempts), 'attempts with a failure reason') + t('Delivery success rate', fmtPct(s.rate), 'successful / all deliveries');
    $('fdaBanner').innerHTML = `Most common failure reason:&nbsp;&nbsp; ${esc(s.top)}`;
    const areas = successByArea(records), worst = areas.length > 1 ? areas.reduce((w, a) => (a.rate < w.rate ? a : w)) : null;
    $('fdaAreaT').innerHTML = table(
      [{ label: 'Area' }, { label: 'Deliveries', align: 'c' }, { label: 'Successful', align: 'c' }, { label: 'Rate', align: 'c' }, { label: 'Redeliveries', align: 'c' }],
      areas.map(a => ({ cells: [a.area + (a === worst ? '  (lowest rate)' : ''), a.deliveries, a.successful, fmtPct(a.rate), a.redeliveries], cls: a === worst ? 'fail' : '' })));
    const rs = failedByReason(records), total = rs.reduce((x, r) => x + r[1], 0);
    $('fdaReasonT').innerHTML = table([{ label: 'Failure reason' }, { label: 'Count', align: 'c' }, { label: 'Share', align: 'c' }],
      rs.map(([k, v]) => ({ cells: [k, v, fmtPct(percent(v, total))] })), 'No failed attempts yet.');
  }

  /* ── charts: delivery_charts.py drawn as SVG (same colours, titles and labels) ── */
  const C = { ink: '#1e1b3a', ink2: '#5b5878', grid: '#e8e6f5', purple: '#6c4de6', orange: '#eb6834' };
  const STATUS_COLORS: Record<string, string> = { Successful: '#0ca30c', Failed: '#d03b3b', Pending: '#fab219' };
  const W = 1000, H = 500;
  const txt = (x: number, y: number, s: string, a = '') => `<text x="${x}" y="${y}" ${a}>${esc(s)}</text>`;
  const head = (title: string, sub: string, x: number, anchor = 'start') =>
    txt(x, 34, title, `class="fx-t" text-anchor="${anchor}"`) + txt(x, 60, sub, `class="fx-st" text-anchor="${anchor}"`);
  const niceMax = (m: number) => Math.max(1, Math.ceil(m));
  const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function chartSvg(key: string): string {
    let g = '';
    if (key === 'reasons') {
      const data = failedByReason(records), total = data.reduce((s, d) => s + d[1], 0);
      const L = 230, R = 950, T = 100, B = 420, max = niceMax(Math.max(0, ...data.map(d => d[1])) + 1);
      g += head('Failed Deliveries by Reason', `${plural(total, 'failed attempt')} across ${plural(data.length, 'reason')}`, L);
      for (let v = 0; v <= max; v++) { const x = L + ((R - L) * v) / max; g += `<line x1="${x}" y1="${T}" x2="${x}" y2="${B}" class="fx-gl"/>` + txt(x, B + 22, String(v), 'class="fx-tk" text-anchor="middle"'); }
      const slot = (B - T) / Math.max(1, data.length);
      data.forEach(([k, v], i) => {
        const y = T + slot * i + slot * 0.2, h = slot * 0.6, w = ((R - L) * v) / max;
        g += `<rect class="fx-grow" x="${L}" y="${y}" width="${w}" height="${h}" fill="${C.purple}"/>`
          + txt(L - 10, y + h / 2 + 5, k, 'class="fx-lb" text-anchor="end"') + txt(L + w + 10, y + h / 2 + 5, `${v}  (${Math.round((v / total) * 100)}%)`, 'class="fx-bv"');
      });
      g += `<line x1="${L}" y1="${B}" x2="${R}" y2="${B}" class="fx-ax"/>` + txt((L + R) / 2, B + 50, 'Failed delivery attempts', 'class="fx-al" text-anchor="middle"');
      if (!data.length) g += txt((L + R) / 2, (T + B) / 2, 'No failed attempts yet', 'class="fx-st" text-anchor="middle"');
    } else if (key === 'areas') {
      const stats = successByArea(records), s = summarize(records), L = 120, R = 950, T = 110, B = 400;
      g += head('Delivery Success Rate by Area', `Share of unique deliveries completed successfully  |  dashed line = all areas (${Math.round(s.rate)}%)`, L);
      [0, 25, 50, 75, 100].forEach(v => { const y = B - ((B - T) * v) / 100; g += `<line x1="${L}" y1="${y}" x2="${R}" y2="${y}" class="fx-gl"/>` + txt(L - 10, y + 5, v + '%', 'class="fx-tk" text-anchor="end"'); });
      const slot = (R - L) / Math.max(1, stats.length);
      stats.forEach((a, i) => {
        const cx = L + slot * (i + 0.5), w = Math.min(slot * 0.5, 210), h = ((B - T) * a.rate) / 100;
        g += `<rect class="fx-grow-y" x="${cx - w / 2}" y="${B - h}" width="${w}" height="${h}" fill="${C.purple}"/>`
          + txt(cx, B - h - 8, Math.round(a.rate) + '%', 'class="fx-bv" text-anchor="middle"')
          + txt(cx, B + 22, a.area, 'class="fx-lb" text-anchor="middle"') + txt(cx, B + 41, plural(a.deliveries, 'delivery'), 'class="fx-lb" text-anchor="middle"');
      });
      const yAvg = B - ((B - T) * s.rate) / 100;
      g += `<line x1="${L}" y1="${yAvg}" x2="${R}" y2="${yAvg}" stroke="${C.ink2}" stroke-width="1.4" stroke-dasharray="7 5"/>`
        + `<line x1="${L}" y1="${B}" x2="${R}" y2="${B}" class="fx-ax"/>` + txt(40, (T + B) / 2, 'Success rate', `class="fx-al" text-anchor="middle" transform="rotate(-90 40 ${(T + B) / 2})"`);
    } else if (key === 'trends') {
      const pts = trend(records), L = 90, R = 960, T = 100, B = 380;
      const fT = pts.reduce((s, p) => s + p.failed, 0), rT = pts.reduce((s, p) => s + p.re, 0);
      g += head('Redelivery Trends', `Daily totals: ${plural(fT, 'failed attempt')}, ${plural(rT, 'redelivery attempt')}`, L);
      const max = niceMax(Math.max(0, ...pts.map(p => Math.max(p.failed, p.re))) + 1);
      for (let v = 0; v <= max; v++) { const y = B - 40 - ((B - 40 - T) * v) / max; g += `<line x1="${L}" y1="${y}" x2="${R}" y2="${y}" class="fx-gl"/>` + txt(L - 12, y + 5, String(v), 'class="fx-tk" text-anchor="end"'); }
      const X = (i: number) => (pts.length < 2 ? (L + R) / 2 : L + 40 + ((R - L - 80) * i) / (pts.length - 1));
      const Y = (v: number) => B - 40 - ((B - 40 - T) * v) / max;
      const step = Math.max(1, Math.ceil(pts.length / 8));
      // the last date always gets a label; a regular one too close to it is skipped so they never overlap
      pts.forEach((p, i) => { if (i === pts.length - 1 || (i % step === 0 && pts.length - 1 - i >= Math.max(1, step * 0.6))) { const d = new Date(p.day + 'T00:00:00'); g += txt(X(i), B + 18, `${MON[d.getMonth()]} ${String(d.getDate()).padStart(2, '0')}`, 'class="fx-tk" text-anchor="middle"'); } });
      const line = (k: 'failed' | 're') => pts.map((p, i) => `${i ? 'L' : 'M'}${X(i)} ${Y(p[k])}`).join(' ');
      if (pts.length) g += `<path d="${line('failed')} L${X(pts.length - 1)} ${Y(0)} L${X(0)} ${Y(0)} Z" fill="${C.purple}" opacity=".1"/>`;
      g += `<path class="fx-draw" d="${line('failed')}" fill="none" stroke="${C.purple}" stroke-width="2.6"/>`
        + `<path class="fx-draw" d="${line('re')}" fill="none" stroke="${C.orange}" stroke-width="2.6" stroke-dasharray="11 6"/>`;
      pts.forEach((p, i) => { g += `<circle cx="${X(i)}" cy="${Y(p.failed)}" r="6" fill="${C.purple}" stroke="#fff" stroke-width="1.6"/>` + `<rect x="${X(i) - 4.5}" y="${Y(p.re) - 4.5}" width="9" height="9" fill="${C.orange}" stroke="#fff" stroke-width="1.4"/>`; });
      const peak = (k: 'failed' | 're', dy: number) => { if (!pts.length) return ''; const m = Math.max(...pts.map(p => p[k])); if (!m) return ''; const i = pts.findIndex(p => p[k] === m); return txt(X(i), Y(m) + dy, String(m), 'class="fx-bv" text-anchor="middle"'); };
      g += peak('failed', -14) + peak('re', 24) + `<line x1="${L}" y1="${B}" x2="${R}" y2="${B}" class="fx-ax"/>`
        + txt(30, (T + B) / 2 - 20, 'Number of attempts', `class="fx-al" text-anchor="middle" transform="rotate(-90 30 ${(T + B) / 2 - 20})"`)
        + `<g transform="translate(${W / 2 - 180} ${H - 25})"><line x1="0" y1="-5" x2="34" y2="-5" stroke="${C.purple}" stroke-width="2.6" stroke-dasharray="9 4"/><circle cx="17" cy="-5" r="5.5" fill="${C.purple}" stroke="#fff" stroke-width="1.4"/>${txt(44, 0, 'Failed attempts', 'class="fx-lg"')}`
        + `<line x1="190" y1="-5" x2="224" y2="-5" stroke="${C.orange}" stroke-width="2.6" stroke-dasharray="9 4"/><rect x="202.5" y="-9.5" width="9" height="9" fill="${C.orange}"/>${txt(234, 0, 'Redelivery attempts', 'class="fx-lg"')}</g>`;
    } else {
      const counts = STATUSES.map(s => [s, deliveryInfos(records).filter(i => i.status === s).length] as [string, number]);
      const total = counts.reduce((s, c) => s + c[1], 0), cx = W / 2, cy = 265, r = 165;
      g += head('Delivery Status', `Latest status of ${plural(total, 'unique delivery')}`, cx, 'middle');
      let a0 = -Math.PI / 2;
      counts.filter(c => c[1] > 0).forEach(([s, n]) => {
        const a1 = a0 + (2 * Math.PI * n) / total, big = a1 - a0 > Math.PI ? 1 : 0;
        const p = (a: number, rr = r) => `${cx + rr * Math.cos(a)} ${cy + rr * Math.sin(a)}`;
        g += n === total ? `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${STATUS_COLORS[s]}"/>`
          : `<path d="M${cx} ${cy} L${p(a0)} A${r} ${r} 0 ${big} 1 ${p(a1)} Z" fill="${STATUS_COLORS[s]}" stroke="#fff" stroke-width="2.5"/>`;
        const mid = (a0 + a1) / 2, lx = cx + (r + 22) * Math.cos(mid), ly = cy + (r + 22) * Math.sin(mid), anchor = Math.cos(mid) >= 0 ? 'start' : 'end';
        g += txt(lx, ly - 2, plural(n, 'delivery'), `class="fx-lb" text-anchor="${anchor}"`) + txt(lx, ly + 18, ((n / total) * 100).toFixed(1) + '%', `class="fx-lb" text-anchor="${anchor}"`);
        a0 = a1;
      });
      if (!total) g += txt(cx, cy, 'No deliveries yet', 'class="fx-st" text-anchor="middle"');
      let lx = 0, legend = '';
      STATUSES.forEach(s => { legend += `<rect x="${lx}" y="-11" width="26" height="9" fill="${STATUS_COLORS[s]}"/>` + txt(lx + 36, 0, s, 'class="fx-lg"'); lx += 36 + s.length * 8.4 + 30; });
      g += `<g transform="translate(${cx - (lx - 30) / 2} ${H - 22})">${legend}</g>`;
    }
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(key)} chart" class="fda-svg">${g}</svg>`;
  }
  function renderCharts() {
    $('fdaChart').innerHTML = chartSvg(chartKey);
    document.querySelectorAll<HTMLElement>('#fdaChartBtns [data-chart]').forEach(b => b.classList.toggle('on', b.dataset.chart === chartKey));
  }

  function renderAll() {
    const s = summarize(records);
    $('fdaFile').textContent = `${plural(s.total, 'attempt')}, ${plural(s.deliveries, 'delivery')} · saved automatically`;
    fillFilterOptions();
    renderRecords(); renderTracking(); renderAnalysis(); renderCharts();
  }

  /* toast (ToastBar) */
  let toastTimer = 0;
  function notify(text: string, kind: 'info' | 'success' | 'error' = 'info') {
    const t = $('fdaToast');
    t.innerHTML = `<span class="fda-chip ${kind}"><i></i>${esc(text)}</span>`;
    t.classList.add('on'); clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('on'), 4000);
  }

  /* pages */
  function show(i: number) {
    page = i;
    document.querySelectorAll<HTMLElement>('#fda .fda-tabs [data-page]').forEach(b => { b.classList.toggle('on', +b.dataset.page! === i); b.setAttribute('aria-selected', String(+b.dataset.page! === i)); });
    document.querySelectorAll<HTMLElement>('#fda .fda-page').forEach(p => p.classList.toggle('on', +p.dataset.page! === i));
    if (i === 3) renderCharts();
  }
  document.querySelectorAll<HTMLElement>('#fda .fda-tabs [data-page]').forEach(b => b.addEventListener('click', () => show(+b.dataset.page!)));

  /* Records page interactions */
  ['fdaQ', 'fdaFArea', 'fdaFStatus', 'fdaFReason', 'fdaFAtt'].forEach(id => $(id).addEventListener(id === 'fdaQ' ? 'input' : 'change', renderRecords));
  $('fdaClear').addEventListener('click', () => { ['fdaQ', 'fdaFArea', 'fdaFStatus', 'fdaFReason', 'fdaFAtt'].forEach(id => ($(id) as HTMLInputElement).value = ''); renderRecords(); });
  $('fdaRecTable').addEventListener('click', e => {
    const th = (e.target as HTMLElement).closest('th');
    if (th) { const i = [...th.parentElement!.children].indexOf(th); sortAsc = i === sortCol ? !sortAsc : true; sortCol = i; renderRecords(); return; }
    const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-key]');
    if (tr) { selected = records[+tr.dataset.key!]; renderRecords(); }
  });
  $('fdaRecTable').addEventListener('dblclick', e => {
    const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-key]');
    if (tr) openDialog(records[+tr.dataset.key!]);
  });
  $('fdaAdd').addEventListener('click', () => openDialog(null));
  $('fdaEdit').addEventListener('click', () => selected && openDialog(selected));
  $('fdaOnlyRe').addEventListener('change', renderTracking);
  $('fdaTrTable').addEventListener('click', e => {
    const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-key]');
    if (tr) { trackSel = tr.dataset.key!; renderTracking(); }
  });
  $('fdaChartBtns').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chart]');
    if (b) { chartKey = b.dataset.chart!; renderCharts(); }
  });

  /* ── RecordDialog ── */
  const REASON_NOTES: Record<string, string> = { Successful: 'not needed: click here if it failed', Failed: 'required: pick one or type your own', Pending: 'optional: pick one or type your own' };
  const NOTES: Record<string, string> = { id: 'e.g. D006', date: 'YYYY-MM-DD, or use Calendar', area: 'pick one or type a new one', attempt: '2 or more = a redelivery', status: '', reason: '' };
  const dlg = { editing: null as Rec | null, errors: {} as Record<string, string> };
  const fId = $<HTMLInputElement>('fdId'), fDate = $<HTMLInputElement>('fdDate'), fArea = $<HTMLInputElement>('fdArea');
  const fAtt = $<HTMLInputElement>('fdAtt'), fStatus = $<HTMLSelectElement>('fdStatus'), fReason = $<HTMLInputElement>('fdReason');
  const boxes: Record<string, HTMLElement> = { id: fId, date: fDate, area: fArea, attempt: fAtt, status: fStatus, reason: fReason };
  function note(field: string) {
    const el = document.querySelector<HTMLElement>(`#fdaDialog [data-note="${field}"]`)!;
    const err = dlg.errors[field];
    el.textContent = err || (field === 'reason' ? REASON_NOTES[fStatus.value] ?? '' : NOTES[field]);
    el.classList.toggle('err', !!err);
    boxes[field].classList.toggle('bad', !!err);
  }
  const notesAll = () => Object.keys(boxes).forEach(note);
  function onStatus() {
    const st = fStatus.value;
    if (st === SUCCESSFUL) { fReason.value = NO_REASON; fReason.readOnly = true; fReason.classList.add('off'); }
    else {
      fReason.readOnly = false; fReason.classList.remove('off');
      $('fdReasons').innerHTML = (st === FAILED ? knownReasons() : [NO_REASON, ...knownReasons()]).map(r => `<option value="${esc(r)}">`).join('');
      if (st === FAILED && fReason.value === NO_REASON) fReason.value = '';
      else if (st === PENDING && !fReason.value) fReason.value = NO_REASON;
    }
    note('reason');
  }
  function onId() {
    if (dlg.editing) return;
    const id = fId.value.trim().toUpperCase(), at = id ? attemptsOf(id) : [];
    const hint = $('fdHint');
    if (at.length) {
      const last = at[at.length - 1];
      if (at.some(a => a.status === SUCCESSFUL)) { hint.textContent = `${id} was already delivered successfully, so another attempt cannot be added.`; return; }
      const n = nextAttempt(id);
      fArea.value = last.area; fAtt.value = String(n);
      hint.textContent = `${id} already has ${plural(at.length, 'attempt')} (latest: ${last.status}). This will be attempt ${n}, a redelivery.`;
    } else { fAtt.value = '1'; hint.textContent = id ? 'New delivery.' : ''; }
  }
  function openDialog(rec: Rec | null) {
    dlg.editing = rec; dlg.errors = {};
    $('fdaDlgTitle').textContent = rec ? 'Edit delivery record' : 'Add delivery record';
    fId.value = rec?.id ?? ''; fDate.value = rec?.day ?? today(); fArea.value = rec?.area ?? '';
    fAtt.value = String(rec?.attempt ?? 1); fStatus.value = rec?.status ?? SUCCESSFUL; fReason.value = rec?.reason ?? NO_REASON;
    $('fdAreas').innerHTML = knownAreas().map(a => `<option value="${esc(a)}">`).join('');
    $('fdHint').textContent = '';
    onStatus(); notesAll();
    $('fdaModal').hidden = false;
    (rec ? fArea : fId).focus();
  }
  const closeDialog = () => { $('fdaModal').hidden = true; };
  fId.addEventListener('input', () => { delete dlg.errors.id; note('id'); onId(); });
  Object.entries(boxes).forEach(([f, el]) => el.addEventListener('input', () => { if (dlg.errors[f]) { delete dlg.errors[f]; note(f); } }));
  fStatus.addEventListener('change', onStatus);
  $('fdReasonWrap').addEventListener('mousedown', () => {
    if (fStatus.value === SUCCESSFUL) {
      fStatus.value = FAILED; onStatus();
      $('fdHint').textContent = 'Status changed to Failed so you can choose a reason. Change it back if the delivery actually succeeded.';
      setTimeout(() => fReason.focus());
    }
  });
  $('fdCal').addEventListener('click', () => { const p = $<HTMLInputElement>('fdPick'); p.value = isDate(fDate.value) ? fDate.value : today(); try { p.showPicker(); } catch { p.focus(); } });
  $('fdPick').addEventListener('change', () => { fDate.value = $<HTMLInputElement>('fdPick').value; fDate.dispatchEvent(new Event('input')); });
  $('fdCancel').addEventListener('click', closeDialog);
  $('fdaModal').addEventListener('keydown', e => { if (e.key === 'Escape') closeDialog(); });
  $('fdaDialog').addEventListener('submit', e => {
    e.preventDefault();
    try {
      const was = dlg.editing;
      const rec = save(fId.value, fDate.value, fArea.value, fAtt.value, fReason.value, fStatus.value, was);
      closeDialog(); selected = rec; renderAll();
      notify(`${was ? 'Updated' : 'Added'} ${rec.id}, attempt ${rec.attempt}. Saved to file.`, 'success');
    } catch (err) {
      if (!(err instanceof ValidationError)) throw err;
      dlg.errors = err.fields; notesAll();
      const first = ['id', 'date', 'area', 'attempt', 'status', 'reason'].find(f => f in err.fields);
      if (first) boxes[first].focus();
    }
  });

  /* ══════════════ console version: delivery_console.py ══════════════ */
  const MENU = `
==================================================
   FAILED DELIVERY AND REDELIVERY PATTERN ANALYZER
==================================================
  1. Add Delivery Records           7. Delivery Success Rate Calculation
  2. View and Search Deliveries     8. Area-Based Delivery Analysis
  3. Update Delivery Records        9. Delivery Trend Monitoring
  4. Filter Delivery Records       10. Delivery Summary
  5. Failed Delivery Analysis      11. Data Visualization
  6. Redelivery Tracking
  0. Exit  (records are saved after every change)
--------------------------------------------------`;
  const term = $('fdaTerm');
  const out = document.createTextNode('');
  const inp = document.createElement('input');
  inp.className = 'fda-in'; inp.setAttribute('aria-label', 'Console input'); inp.autocomplete = 'off'; inp.spellcheck = false;
  term.append(out, inp);
  let waiting: ((v: string) => void) | null = null;
  const write = (s: string) => {
    out.data += s;
    if (out.data.length > 40000) out.data = out.data.slice(-30000);
    term.scrollTop = term.scrollHeight;
  };
  const print = (s = '') => write(s + '\n');
  const input = (prompt: string) => { write(prompt); return new Promise<string>(res => { waiting = res; }); };
  inp.addEventListener('keydown', e => {
    if (e.key !== 'Enter' || !waiting) return;
    const v = inp.value; inp.value = ''; write(v + '\n');
    const w = waiting; waiting = null; w(v);
  });
  term.addEventListener('click', () => { if (!window.getSelection()?.toString()) inp.focus({ preventScroll: true }); });

  async function askText(prompt: string, optional = false) {
    for (;;) { const t = (await input(prompt)).trim(); if (t || optional) return t; print('  This field cannot be empty.'); }
  }
  async function askChoice(title: string, options: string[], optional = false, other = false) {
    print(title);
    options.forEach((o, i) => print(`  ${i + 1}. ${o}`));
    if (other) print(`  ${options.length + 1}. Other (type your own)`);
    for (;;) {
      const t = (await input(`Choose a number${optional ? ' (Enter to skip)' : ''}: `)).trim();
      if (optional && !t) return '';
      if (/^\d+$/.test(t) && +t >= 1 && +t <= options.length) return options[+t - 1];
      if (other && /^\d+$/.test(t) && +t === options.length + 1) return askText('  Type it: ');
      print('  Please choose one of the numbers shown.');
    }
  }
  async function askInt(prompt: string, min = 1) {
    for (;;) { const t = (await input(prompt)).trim(); const v = /^-?\d+$/.test(t) ? +t : min - 1; if (v >= min) return v; print(`  Please enter a whole number (${min} or more).`); }
  }
  function ptable(headers: string[], rows: unknown[][]) {
    if (!rows.length) { print('  (nothing to show)'); return; }
    const cells = rows.map(r => r.map(String));
    const widths = headers.map((h, i) => Math.max(h.length, ...cells.map(r => r[i].length)));
    const numeric = headers.map((_, i) => cells.every(r => /^\d+$/.test(r[i].replace('.', '').replace('%', ''))));
    const line = (vals: string[]) => vals.map((v, i) => (numeric[i] ? v.padStart(widths[i]) : v.padEnd(widths[i]))).join('  ').trimEnd();
    print(line(headers)); print('-'.repeat(line(headers).length)); cells.forEach(r => print(line(r)));
  }
  const attemptRows = (rs: Rec[]) => sortRecords(rs).map(r => [r.id, r.day, r.area, r.attempt, r.reason, r.status]);
  const heading = (t: string) => print(`\n=== ${t} ===`);
  const notSaved = (err: unknown) => { if (err instanceof ValidationError) print('Not saved:\n  ' + err.errors.join('\n  ')); else throw err; };

  const ACTIONS: Record<string, () => Promise<void> | void> = {
    async 1() {
      heading('Add Delivery Records');
      const id = (await askText('Delivery ID (example D006): ')).toUpperCase();
      const existing = attemptsOf(id);
      let area: string, number: number;
      if (existing.length) {
        area = existing[existing.length - 1].area; number = nextAttempt(id);
        print(`  ${id} already has ${plural(existing.length, 'attempt')}; this will be attempt ${number} in ${area}.`);
      } else {
        const areas = knownAreas();
        area = areas.length ? await askChoice('Delivery area:', areas, false, true) : await askText('Delivery area (example Area A): ');
        number = 1;
      }
      const day = (await input(`Delivery date YYYY-MM-DD [Enter for ${today()}]: `)).trim() || today();
      const status = await askChoice('Final status of this attempt:', STATUSES);
      let reason = NO_REASON;
      if (status === FAILED) reason = await askChoice('Failure reason:', knownReasons(), false, true);
      else if (status === PENDING) reason = (await askChoice('Failure reason of this attempt:', knownReasons(), true, true)) || NO_REASON;
      try { const r = save(id, day, area, String(number), reason, status, null); print(`Saved ${r.id}, attempt ${r.attempt}.`); renderAll(); }
      catch (e) { notSaved(e); }
    },
    async 2() {
      heading('View and Search Deliveries');
      const kw = (await input('Delivery ID, or part of it (Enter to show every record): ')).trim();
      const found = filterRecords(records, kw);
      print(`\n${plural(found.length, 'record')}:`); ptable(FIELDS, attemptRows(found));
    },
    async 3() {
      heading('Update Delivery Records');
      const at = attemptsOf(await askText('Delivery ID to update: '));
      if (!at.length) { print('  No delivery has that ID.'); return; }
      let rec = at[0];
      if (at.length > 1) {
        ptable(FIELDS, attemptRows(at));
        const want = await askInt('Which attempt number? ');
        const ch = at.filter(a => a.attempt === want);
        if (!ch.length) { print('  That attempt does not exist.'); return; }
        rec = ch[0];
      }
      print('Press Enter to keep the current value.');
      const keep = async (p: string, cur: unknown) => (await input(`${p} [${cur}]: `)).trim() || String(cur);
      const day = await keep('Delivery date', rec.day), area = await keep('Delivery area', rec.area), num = await keep('Attempt number', rec.attempt);
      const status = await keep(`Final status (${STATUSES.join('/')})`, rec.status);
      let reason = await keep('Failure reason', rec.reason);
      if (status === SUCCESSFUL) reason = NO_REASON;
      try { save(rec.id, day, area, num, reason, status, rec); print('Updated.'); renderAll(); } catch (e) { notSaved(e); }
    },
    async 4() {
      heading('Filter Delivery Records (press Enter to skip a filter)');
      const area = await askChoice('Area:', knownAreas(), true);
      const status = await askChoice('Status:', STATUSES, true);
      const reason = await askChoice('Failure reason:', [NO_REASON, ...knownReasons()], true);
      const att = await askChoice('Attempts per delivery:', ['1', '2', '3+'], true);
      const found = filterRecords(records, '', area, status, reason, att);
      print(`\n${plural(found.length, 'matching attempt')}:`); ptable(FIELDS, attemptRows(found));
    },
    5() {
      heading('Failed Delivery Analysis');
      const rs = failedByReason(records), total = rs.reduce((s, r) => s + r[1], 0);
      ptable(['Failure reason', 'Failed attempts', 'Share'], rs.map(([k, v]) => [k, v, fmtPct(percent(v, total))]));
      print(`\nMost common failure reason: ${summarize(records).top}`);
    },
    6() {
      heading('Redelivery Tracking');
      const infos = deliveryInfos(records), again = infos.filter(i => i.attempts > 1).sort((a, b) => b.attempts - a.attempts || cmp(a.id, b.id));
      ptable(['Delivery ID', 'Area', 'Attempts', 'Latest status', 'Latest failure reason'], again.map(i => [i.id, i.area, i.attempts, i.status, i.lastReason]));
      print(`\n${again.length} of ${plural(infos.length, 'delivery')} needed more than one attempt (${fmtPct(percent(again.length, infos.length))}).`);
    },
    7() {
      heading('Delivery Success Rate Calculation');
      const s = summarize(records);
      print(`  Successful deliveries : ${s.successful} of ${plural(s.deliveries, 'unique delivery')}`);
      print(`  Delivery success rate : ${fmtPct(s.rate)}`);
    },
    8() {
      heading('Area-Based Delivery Analysis');
      const st = successByArea(records);
      ptable(['Area', 'Deliveries', 'Successful', 'Redeliveries', 'Success rate'], st.map(a => [a.area, a.deliveries, a.successful, a.redeliveries, fmtPct(a.rate)]));
      if (st.length > 1) { const w = st.reduce((x, a) => (a.rate < x.rate ? a : x)); print(`\nLowest success rate: ${w.area} (${fmtPct(w.rate)})`); }
    },
    9() {
      heading('Delivery Trend Monitoring');
      ptable(['Date', 'Failed attempts', 'Redelivery attempts'], trend(records).map(p => [p.day, p.failed, p.re]));
    },
    10() {
      heading('Delivery Summary');
      const s = summarize(records);
      ([['Total delivery attempts', s.total], ['Unique deliveries', s.deliveries], ['Successful deliveries', s.successful],
        ['Failed deliveries', s.failed], ['Pending deliveries', s.pending], ['Deliveries requiring redelivery', s.redeliveries],
        ['Failed delivery attempts', s.failedAttempts], ['Delivery success rate', fmtPct(s.rate)], ['Most common failure reason', s.top]] as [string, unknown][])
        .forEach(([k, v]) => print(`  ${k.padEnd(32)}${v}`));
    },
    async 11() {
      heading('Data Visualization');
      if (!records.length) { print('  No records yet. Add some first.'); return; }
      const titles = ['Failed Deliveries by Reason', 'Delivery Success Rate by Area', 'Redelivery Trends', 'Delivery Status'], keys = ['reasons', 'areas', 'trends', 'status'];
      const pick = await askChoice('Which chart?', [...titles, 'All four charts']);
      const chosen = pick === 'All four charts' ? keys : [keys[titles.indexOf(pick)]];
      print('Close the chart window(s) to return to the menu.');
      for (let i = 0; i < chosen.length; i++) {
        $('fdaFigTitle').textContent = `Figure ${i + 1}`;
        $('fdaFigBody').innerHTML = chartSvg(chosen[i]);
        $('fdaFig').hidden = false;
        await new Promise<void>(res => { $('fdaFigClose').onclick = () => { $('fdaFig').hidden = true; res(); }; });
      }
    },
  };
  let started = false;
  async function consoleMain() {
    started = true;
    print(`Loaded ${plural(records.length, 'record')} from delivery_records.csv.`);
    for (;;) {
      print(MENU);
      const choice = (await input('Choose an option: ')).trim();
      if (choice === '0') {
        print('All changes are already saved. Goodbye!');
        await input('\nPress Enter to start the program again. ');
        out.data = ''; print(`Loaded ${plural(records.length, 'record')} from delivery_records.csv.`);
        continue;
      }
      const action = ACTIONS[choice];
      if (action) await action(); else print('  Invalid choice. Enter a number from the menu.');
    }
  }

  /* version switch */
  document.querySelectorAll<HTMLElement>('#fda [data-mode]').forEach(b => b.addEventListener('click', () => {
    const con = b.dataset.mode === 'con';
    document.querySelectorAll<HTMLElement>('#fda [data-mode]').forEach(x => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
    $('fdaWin').hidden = con; $('fdaCon').hidden = !con;
    if (con) { if (!started) consoleMain(); inp.focus({ preventScroll: true }); } else renderAll();
  }));

  renderAll();
  notify('Loaded 7 records from delivery_records.csv.');
</script>

