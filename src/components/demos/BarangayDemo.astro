---
/* Barangay Safety — the real app, both sides of it.
   Left: the resident app; right: the barangay-hall web dashboard. Both are Ian's actual Flutter
   code compiled for the web (public/demos/*, built from demos-src/barangay), running on sample
   data with a backend that lives in the browser. This page relays between them: a report filed
   on the phone is handed to the dashboard, and what the hall does is handed back to the phone. */
---
<div class="bsd" id="bsd" data-lenis-prevent>
  <div class="bsd-steps" id="bsdSteps" aria-label="Demo steps">
    <span class="on" data-s="0"><b>1</b> File a report on the phone</span>
    <span data-s="1"><b>2</b> Open it at the barangay hall</span>
    <span data-s="2"><b>3</b> Press &ldquo;I'm responding&rdquo;</span>
    <span data-s="3"><b>4</b> Resolve it</span>
    <button type="button" class="bsd-reset" id="bsdReset">&#8635; Reset demo</button>
  </div>
  <p class="bsd-hint" id="bsdHint" aria-live="polite"></p>

  <div class="bsd-stage">
    <figure class="bsd-phone">
      <div class="bsd-bezel">
        <iframe id="bsdResident" title="Barangay Safety resident app (demo)" data-src="/demos/barangay-resident/index.html" loading="lazy"></iframe>
      </div>
      <figcaption>Resident app &middot; Maria Santos, Barangay 3</figcaption>
    </figure>
    <figure class="bsd-hall">
      <div class="bsd-browser">
        <div class="bsd-tabbar"><i></i><i></i><i></i><span>Barangay Safety &middot; Barangay Hall</span></div>
        <div class="bsd-viewport" id="bsdViewport">
          <iframe id="bsdHall" title="Barangay Safety barangay-hall dashboard (demo)" data-src="/demos/barangay/index.html" loading="lazy"></iframe>
        </div>
      </div>
      <figcaption>Barangay-hall dashboard &middot; Juan Dela Cruz, secretary</figcaption>
    </figure>
  </div>

  <p class="bsd-foot">Both screens are the real Flutter app, compiled for the web and running on sample data inside your browser &mdash; nothing is sent anywhere, and your location is never used (the phone sits at a fixed spot in Barangay&nbsp;3). Escalation runs on a demo clock: 25&nbsp;seconds instead of 5&nbsp;minutes.</p>
</div>

<script>
  const root = document.getElementById('bsd')!;
  const resident = document.getElementById('bsdResident') as HTMLIFrameElement;
  const hall = document.getElementById('bsdHall') as HTMLIFrameElement;
  const hint = document.getElementById('bsdHint')!;
  const HINTS = [
    'On the phone, tap <b>Report an Incident</b>, pick something the barangay handles &mdash; <b>Suspicious Activity</b> or <b>Noise Disturbance</b> &mdash; and send it. (Fire or Medical Emergency sends you to the right agency instead, exactly like the real app.)',
    'The report just arrived on the dashboard. Open <b>Incidents</b> and tap it &mdash; or wait 25&nbsp;seconds and the &ldquo;unanswered report&rdquo; alert will bring it to you.',
    'Press <b>I&rsquo;m responding</b>. The phone gets the real &ldquo;help is on the way&rdquo; pop-up.',
    'Now <b>Mark On Scene</b>, then resolve it. The resident&rsquo;s report follows every step.',
    'That is the whole loop &mdash; report, alert, response, resolution. Press <b>Reset demo</b> to try another one.',
  ];
  let step = 0, hallReady = false, queue: string[] = [];

  function setStep(s: number) {
    step = Math.max(step, s);
    root.querySelectorAll<HTMLElement>('[data-s]').forEach(el => {
      const n = +el.dataset.s!;
      el.classList.toggle('on', n === step);
      el.classList.toggle('done', n < step);
    });
    hint.innerHTML = HINTS[step];
  }

  const send = (frame: HTMLIFrameElement, data: string) => frame.contentWindow?.postMessage(data, location.origin);

  /* the relay between the two apps */
  addEventListener('message', e => {
    if (e.origin !== location.origin || typeof e.data !== 'string') return;
    let m: { type?: string; app?: string; status?: string };
    try { m = JSON.parse(e.data); } catch { return; }
    if (e.source === resident.contentWindow) {
      if (m.type === 'report') {
        const msg = JSON.stringify({ ...m, escalateAfter: 25 });
        hallReady ? send(hall, msg) : queue.push(msg);
        setStep(1);
      }
    } else if (e.source === hall.contentWindow) {
      if (m.type === 'ready') { hallReady = true; queue.forEach(q => send(hall, q)); queue = []; }
      else if (m.type === 'status' || m.type === 'escalated') {
        send(resident, e.data);
        if (m.type === 'escalated') setStep(2);  // the alert's "Open report" takes them straight to it
        else if (m.status === 'responding' || m.status === 'on_scene') setStep(3);
        else if (m.status === 'resolved' || m.status === 'closed') setStep(4);
      }
    }
  });

  function load() {
    hallReady = false; queue = [];
    [resident, hall].forEach(f => { f.src = f.dataset.src!; });
  }
  /* the two apps are ~13 MB together: fetch them only when the demo comes into view */
  const io = new IntersectionObserver(entries => {
    if (entries.some(en => en.isIntersecting)) { load(); io.disconnect(); }
  }, { rootMargin: '400px 0px' });
  io.observe(root);

  /* the dashboard is a desktop web app: on narrow screens it keeps its desktop size and is scaled down to fit */
  const viewport = document.getElementById('bsdViewport')!;
  const DESK_W = 1100, DESK_H = 760;
  const stacked = matchMedia('(max-width: 980px)');  // same breakpoint as the CSS that stacks phone over dashboard
  function fit() {
    const w = viewport.clientWidth, narrow = stacked.matches && w < DESK_W;
    const s = narrow ? w / DESK_W : 1;
    hall.style.width = narrow ? DESK_W + 'px' : '';
    hall.style.height = narrow ? DESK_H + 'px' : '';
    hall.style.transform = narrow ? `scale(${s})` : '';
    viewport.style.height = narrow ? Math.round(DESK_H * s) + 'px' : '';
  }
  addEventListener('resize', fit);
  fit();

  document.getElementById('bsdReset')!.addEventListener('click', () => {
    step = 0;
    setStep(0);
    load();
  });
  setStep(0);
</script>

<style is:global>
  .bsd{position:relative;left:50%;transform:translateX(-50%);width:min(1240px,calc(100vw - 32px))}
  .bsd-steps{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  .bsd-steps span{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px 0 6px;border:.6px solid var(--brd2);border-radius:17px;font-family:var(--sans);font-size:12px;color:var(--fg3);transition:color .3s,border-color .3s,background .3s}
  .bsd-steps span b{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;border:.6px solid var(--brd2);font-family:var(--mono);font-size:10px;font-weight:400}
  .bsd-steps span.on{color:var(--fg);border-color:#e0574b;background:rgba(224,87,75,.08)}
  .bsd-steps span.on b{background:#e0574b;border-color:#e0574b;color:#fff}
  .bsd-steps span.done{color:var(--fg2)}
  .bsd-steps span.done b{background:rgba(111,207,127,.16);border-color:#6fcf7f;color:#8fe39e}
  .bsd-reset{margin-left:auto;height:34px;padding:0 16px;border:.6px solid var(--brd2);border-radius:3px;background:none;color:var(--fg2);font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
  .bsd-reset:hover{color:var(--fg);border-color:var(--fg3)}
  .bsd-hint{min-height:44px;margin:0 0 18px;font-family:var(--sans);font-size:13.5px;font-weight:300;line-height:1.6;color:var(--fg2);max-width:900px}
  .bsd-hint b{color:var(--fg);font-weight:500}

  .bsd-stage{display:grid;grid-template-columns:380px 1fr;gap:28px;align-items:start}
  .bsd figure{margin:0;display:flex;flex-direction:column;align-items:center;gap:12px;min-width:0}
  .bsd figcaption{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--fg3)}
  .bsd iframe{display:block;border:0;background:#0d47a1;width:100%}

  .bsd-bezel{width:380px;padding:12px;border-radius:52px;background:#0c0c0e;box-shadow:0 0 0 1.5px #3a3a40,0 30px 70px rgba(0,0,0,.55)}
  .bsd-bezel iframe{height:760px;border-radius:40px}

  .bsd-hall{width:100%}
  .bsd-browser{width:100%;border-radius:10px;overflow:hidden;background:#dee1e6;box-shadow:0 30px 80px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.08)}
  .bsd-tabbar{display:flex;align-items:center;gap:7px;height:36px;padding:0 14px;font:12px "Segoe UI",system-ui,sans-serif;color:#3c4043}
  .bsd-tabbar i{width:11px;height:11px;border-radius:50%;background:#c4c7cc}
  .bsd-tabbar span{margin-left:10px;padding:6px 14px;border-radius:8px 8px 0 0;background:#fff;align-self:flex-end}
  .bsd-viewport{position:relative;overflow:hidden}
  .bsd-browser iframe{height:748px;transform-origin:0 0}
  .bsd-foot{margin:26px 0 0;max-width:900px;font-family:var(--sans);font-size:12.5px;font-weight:300;line-height:1.65;color:var(--fg3)}

  html:not(.touch) .bsd-reset{cursor:none}

  @media(max-width:980px){
    .bsd-stage{grid-template-columns:1fr;gap:34px}
    .bsd-bezel{width:min(380px,100%)}
    .bsd-bezel iframe{height:min(760px,170vw)}
    .bsd-reset{margin-left:0}
  }
</style>
