---
/* "Ask Ian's AI" — floating chat panel. Talks to /api/chat (Gemini, server-side). */
const suggestions = [
  'What has Ian built?',
  'Tell me about Barangay Safety',
  'What tech does Ian use?',
  'How can I contact Ian?',
];
---
<button class="ai-fab" type="button" data-open-chat aria-label="Ask Ian's AI">
  <span class="ai-fab-glyph" aria-hidden="true">✦</span><span class="ai-fab-txt">Ask AI</span>
</button>

<section class="ai" id="aiPanel" role="dialog" aria-modal="false" aria-labelledby="aiTitle" hidden>
  <header class="ai-head">
    <div>
      <div class="ai-title" id="aiTitle">Ask about Ian</div>
      <div class="ai-sub"><span class="ai-live"></span>AI assistant · answers from this portfolio</div>
    </div>
    <div class="ai-head-btns">
      <button type="button" class="ai-icon" id="aiReset" aria-label="New conversation" title="New conversation">↺</button>
      <button type="button" class="ai-icon" id="aiClose" aria-label="Close">×</button>
    </div>
  </header>
  <div class="ai-log" id="aiLog" aria-live="polite" data-lenis-prevent>
    <div class="ai-msg ai-bot">Hi! I'm Ian's AI assistant. Ask me about his projects, skills, education — or how to work with him.</div>
  </div>
  <div class="ai-chips" id="aiChips">
    {suggestions.map(s => <button type="button" class="ai-chip">{s}</button>)}
  </div>
  <form class="ai-form" id="aiForm" autocomplete="off">
    <input id="aiInput" type="text" maxlength="600" placeholder="Ask anything about Ian…" aria-label="Your question">
    <button type="submit" class="ai-send" aria-label="Send">→</button>
  </form>
</section>

<script>
  const panel = document.getElementById('aiPanel') as HTMLElement;
  const log = document.getElementById('aiLog') as HTMLElement;
  const form = document.getElementById('aiForm') as HTMLFormElement;
  const input = document.getElementById('aiInput') as HTMLInputElement;
  const chips = document.getElementById('aiChips') as HTMLElement;
  const KEY = 'ikm-ai-chat';
  type Turn = { role: 'user' | 'model'; text: string };
  let history: Turn[] = [];
  let busy = false;

  /* turn "/projects/x/" paths and emails in a reply into links — built with DOM nodes, never innerHTML */
  function linkify(el: HTMLElement, text: string) {
    const re = /(\/projects\/[a-z0-9-]+\/?|[\w.+-]+@[\w-]+\.[\w.]+|https?:\/\/[^\s)]+)/g;
    let last = 0;
    for (const m of text.matchAll(re)) {
      el.appendChild(document.createTextNode(text.slice(last, m.index)));
      const a = document.createElement('a');
      const v = m[0].replace(/[.,]$/, '');
      a.href = v.includes('@') ? `mailto:${v}` : v;
      if (v.startsWith('http')) { a.target = '_blank'; a.rel = 'noopener'; }
      a.textContent = v;
      el.appendChild(a);
      last = (m.index ?? 0) + v.length;
    }
    el.appendChild(document.createTextNode(text.slice(last)));
  }
  /* the model sometimes answers in markdown: **bold** becomes <strong>, "* " bullets become "- " */
  function render(el: HTMLElement, text: string) {
    text.split('\n').forEach((line, li) => {
      if (li) el.appendChild(document.createElement('br'));
      line.replace(/^\s*\*\s+/, '- ').split(/\*\*(.+?)\*\*/g).forEach((part, i) => {
        if (i % 2) { const b = document.createElement('strong'); linkify(b, part); el.appendChild(b); }
        else linkify(el, part);
      });
    });
  }
  function add(role: 'user' | 'bot' | 'err', text: string) {
    const d = document.createElement('div');
    d.className = `ai-msg ai-${role}`;
    render(d, text);
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    return d;
  }
  function save() { try { sessionStorage.setItem(KEY, JSON.stringify(history)); } catch {} }
  try {
    history = JSON.parse(sessionStorage.getItem(KEY) || '[]');
    history.forEach(t => add(t.role === 'user' ? 'user' : 'bot', t.text));
    if (history.length) chips.hidden = true;
  } catch { history = []; }

  async function ask(q: string) {
    q = q.trim();
    if (!q || busy) return;
    busy = true;
    chips.hidden = true;
    add('user', q);
    history.push({ role: 'user', text: q });
    const typing = add('bot', '');
    typing.classList.add('ai-typing');
    typing.innerHTML = '<span></span><span></span><span></span>';
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json().catch(() => ({}));
      typing.remove();
      if (data.reply) {
        add('bot', data.reply);
        history.push({ role: 'model', text: data.reply });
      } else {
        history.pop();
        add('err', data.error || 'Something went wrong. Please try again.');
      }
    } catch {
      typing.remove();
      history.pop();
      add('err', "Couldn't reach the assistant — check your connection and try again.");
    }
    save();
    busy = false;
    return history[history.length - 1]?.role === 'model' ? history[history.length - 1].text : null;
  }

  function open(q?: string) {
    panel.hidden = false;
    document.documentElement.classList.add('ai-open');
    requestAnimationFrame(() => panel.classList.add('on'));
    if (q) ask(q); else setTimeout(() => input.focus(), 250);
  }
  function close() {
    panel.classList.remove('on');
    document.documentElement.classList.remove('ai-open');
    setTimeout(() => { if (!panel.classList.contains('on')) panel.hidden = true; }, 300);
  }

  document.addEventListener('click', e => {
    if ((e.target as HTMLElement).closest('[data-open-chat]')) panel.hidden ? open() : close();
  });
  document.getElementById('aiClose')!.addEventListener('click', close);
  document.getElementById('aiReset')!.addEventListener('click', () => {
    history = []; save();
    log.querySelectorAll('.ai-msg:not(:first-child)').forEach(n => n.remove());
    chips.hidden = false;
    input.focus();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) close(); });
  chips.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('.ai-chip');
    if (b) ask(b.textContent || '');
  });
  form.addEventListener('submit', e => {
    e.preventDefault();
    const q = input.value;
    input.value = '';
    ask(q);
  });

  /* the terminal's `ask` command reuses this */
  (window as any).ikmChat = { open, ask };
</script>

<style is:global>
  .ai-fab{
    position:fixed;left:24px;bottom:24px;z-index:600;
    display:flex;align-items:center;gap:9px;
    height:44px;padding:0 18px 0 14px;border-radius:999px;
    background:rgba(28,24,20,.86);border:.7px solid rgba(219,185,94,.4);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    color:var(--fg);font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
    box-shadow:0 10px 40px rgba(0,0,0,.45);cursor:pointer;
    transition:transform .35s cubic-bezier(.25,1,.5,1),border-color .3s,opacity .3s;
  }
  html:not(.touch) .ai-fab, html:not(.touch) .ai button{cursor:none}
  .ai-fab:hover{transform:translateY(-3px);border-color:var(--gold)}
  .ai-fab-glyph{color:var(--gold);font-size:14px;line-height:1}
  html.ai-open .ai-fab{opacity:0;pointer-events:none}

  .ai{
    position:fixed;left:24px;bottom:24px;z-index:700;
    width:min(400px,calc(100vw - 32px));height:min(580px,calc(100svh - 110px));
    display:flex;flex-direction:column;
    background:rgba(19,17,9,.94);border:.7px solid var(--brd2);border-radius:6px;
    backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
    box-shadow:0 30px 90px rgba(0,0,0,.6);
    opacity:0;transform:translateY(16px) scale(.98);transform-origin:bottom left;
    transition:opacity .3s,transform .4s cubic-bezier(.25,1,.5,1);
  }
  .ai.on{opacity:1;transform:none}
  .ai[hidden]{display:none}
  .ai-head{display:flex;justify-content:space-between;align-items:flex-start;padding:18px 18px 14px;border-bottom:.6px solid var(--brd)}
  .ai-title{font-family:var(--serif);font-size:20px;font-weight:700;color:var(--fg)}
  .ai-sub{display:flex;align-items:center;gap:7px;margin-top:4px;font-family:var(--mono);font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg3)}
  .ai-live{width:6px;height:6px;border-radius:50%;background:#6fcf7f;box-shadow:0 0 8px #6fcf7f}
  .ai-head-btns{display:flex;gap:6px}
  .ai-icon{width:30px;height:30px;border-radius:2px;background:none;border:.6px solid var(--brd2);color:var(--fg3);font-size:16px;line-height:1;cursor:pointer;transition:color .3s,border-color .3s}
  .ai-icon:hover{color:var(--gold);border-color:var(--gold)}
  .ai-log{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:10px;overscroll-behavior:contain}
  .ai-msg{max-width:88%;padding:10px 13px;border-radius:4px;font-family:var(--sans);font-size:13px;font-weight:300;line-height:1.6;letter-spacing:.01em;word-wrap:break-word}
  .ai-msg a{color:var(--gold);text-underline-offset:3px}
  .ai-msg strong{font-weight:600;color:var(--fg)}
  .ai-bot{align-self:flex-start;background:var(--bg3);color:var(--fg2);border:.6px solid var(--brd)}
  .ai-user{align-self:flex-end;background:rgba(219,185,94,.12);color:var(--fg);border:.6px solid rgba(219,185,94,.28)}
  .ai-err{align-self:flex-start;background:rgba(224,87,75,.08);color:#f0a59d;border:.6px solid rgba(224,87,75,.3)}
  .ai-typing{display:flex;gap:5px;padding:14px}
  .ai-typing span{width:6px;height:6px;border-radius:50%;background:var(--fg3);animation:aiDot 1.1s infinite ease-in-out}
  .ai-typing span:nth-child(2){animation-delay:.15s}
  .ai-typing span:nth-child(3){animation-delay:.3s}
  @keyframes aiDot{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-4px)}}
  .ai-chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 18px 12px}
  .ai-chips[hidden]{display:none}
  .ai-chip{
    font-family:var(--sans);font-size:11px;font-weight:300;color:var(--fg2);
    background:transparent;border:.6px solid var(--brd2);border-radius:999px;padding:6px 12px;cursor:pointer;
    transition:color .3s,border-color .3s;
  }
  .ai-chip:hover{color:var(--gold);border-color:rgba(219,185,94,.5)}
  .ai-form{display:flex;gap:8px;padding:12px;border-top:.6px solid var(--brd)}
  .ai-form input{
    flex:1;min-width:0;height:42px;padding:0 14px;border-radius:3px;
    background:var(--bg);border:.6px solid var(--brd2);color:var(--fg);
    font-family:var(--sans);font-size:14px;font-weight:300;outline:none;
  }
  .ai-form input:focus{border-color:rgba(219,185,94,.55)}
  .ai-send{width:42px;height:42px;border-radius:3px;border:none;background:var(--gold);color:#14110d;font-size:18px;cursor:pointer;transition:background .3s}
  .ai-send:hover{background:var(--gold2)}
  @media(max-width:680px){
    /* the nav already has an Ask AI button on phones — the floating one only covered content */
    .ai-fab{display:none}
    .ai{left:8px;right:8px;bottom:8px;width:auto;height:min(78svh,600px)}
  }
</style>
