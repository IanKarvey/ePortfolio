---
/* Terminal mode — Ctrl+K (or ~, or the >_ button) opens a shell for exploring the portfolio. */
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(p => ({ id: p.id, title: p.data.title, type: p.data.type, year: p.data.year, tagline: p.data.tagline, stack: p.data.stack, demo: !!p.data.demo }));
const data = JSON.stringify({ projects, profile });
---
<div class="term" id="term" hidden>
  <div class="term-backdrop" data-term-close></div>
  <div class="term-win" role="dialog" aria-modal="true" aria-label="Terminal">
    <div class="term-bar">
      <span class="term-dots"><i></i><i></i><i></i></span>
      <span class="term-name">ian@portfolio: ~</span>
      <button type="button" class="term-x" data-term-close aria-label="Close terminal">esc</button>
    </div>
    <div class="term-out" id="termOut" data-lenis-prevent></div>
    <form class="term-line" id="termForm" autocomplete="off">
      <span class="term-ps">ian@portfolio:~$</span>
      <input id="termIn" type="text" spellcheck="false" aria-label="Command" autocapitalize="off">
    </form>
  </div>
</div>
<script type="application/json" id="termData" set:html={data} />

<script>
  const { projects, profile } = JSON.parse(document.getElementById('termData')!.textContent || '{}');
  const term = document.getElementById('term') as HTMLElement;
  const out = document.getElementById('termOut') as HTMLElement;
  const form = document.getElementById('termForm') as HTMLFormElement;
  const input = document.getElementById('termIn') as HTMLInputElement;
  const past: string[] = [];
  let pi = 0;
  let booted = false;
  const aiTurns: { role: 'user' | 'model'; text: string }[] = [];

  type Part = string | { t: string; c?: string; href?: string; cmd?: string };
  function print(...parts: Part[]) {
    const line = document.createElement('div');
    line.className = 'term-l';
    parts.forEach(p => {
      if (typeof p === 'string') return line.appendChild(document.createTextNode(p));
      const el = document.createElement(p.href ? 'a' : p.cmd ? 'button' : 'span');
      el.textContent = p.t;
      if (p.c) el.className = p.c;
      if (p.href) (el as HTMLAnchorElement).href = p.href;
      if (p.cmd) { (el as HTMLButtonElement).type = 'button'; el.classList.add('term-cmd'); el.dataset.cmd = p.cmd; }
      line.appendChild(el);
    });
    out.appendChild(line);
    out.scrollTop = out.scrollHeight;
    return line;
  }
  const gap = () => print('');
  const find = (q: string) => {
    q = q.toLowerCase();
    return projects.find((p: any) => p.id === q || p.id.startsWith(q) || p.title.toLowerCase().includes(q));
  };

  const commands: Record<string, { help: string; run: (args: string) => void | Promise<void> }> = {
    help: { help: 'list commands', run: () => {
      Object.entries(commands).forEach(([k, v]) => { if (!v.help.startsWith('_')) print({ t: k.padEnd(10), cmd: k, c: 'term-k' }, v.help); });
      gap(); print({ t: 'tip: ', c: 'term-dim' }, 'Tab completes, ↑ ↓ walks history, click any highlighted word.');
    }},
    whoami: { help: 'who is Ian?', run: () => {
      print({ t: profile.name, c: 'term-hi' });
      print(profile.headline);
      print({ t: 'based in ', c: 'term-dim' }, profile.location);
      print({ t: '● ', c: 'term-ok' }, { t: profile.availability, c: 'term-ok' }, '  ', { t: 'recruiter', cmd: 'recruiter' });
    }},
    recruiter: { help: '30-second summary + CV', run: () => { print('opening recruiter mode…'); setTimeout(() => { close(); (window as any).ikmRecruiter?.(); }, 250); } },
    cv: { help: 'download Ian\'s CV (PDF)', run: () => {
      print({ t: '↓ ', c: 'term-gold' }, { t: 'Ian-Karvey-Manimtim-CV.pdf', href: '/Ian-Karvey-Manimtim-CV.pdf' }, { t: '   or view online: ', c: 'term-dim' }, { t: '/cv/', href: '/cv/' });
    }},
    proof: { help: 'proof <skill> — which project proves it', run: a => {
      const fn = (window as any).ikmProof;
      if (!fn) return print({ t: 'proof lives on the home page — ', c: 'term-dim' }, { t: 'goto skills', cmd: 'goto skills' });
      if (!a) return print({ t: 'usage: proof <skill>   try: ', c: 'term-err' }, ...((window as any).ikmProofKeys?.() ?? []).slice(0, 6).map((k: string) => ({ t: k + ' ', cmd: `proof ${k}` })));
      const t = fn(a);
      if (!t) return print({ t: `no shipped project uses "${a}" yet`, c: 'term-err' });
      print({ t: '✓ ', c: 'term-ok' }, `${t.label} — used in `, ...t.proofs.map((p: any, i: number) => ({ t: p.title + (i < t.proofs.length - 1 ? ', ' : ''), cmd: `open ${p.id}` })));
      t.proofs.forEach((p: any) => print({ t: '  ' + p.title + ': ', c: 'term-dim' }, p.where));
    }},
    brief: { help: 'brief <idea> — get an AI plan for your project', run: a => {
      print('opening the project planner…');
      setTimeout(() => { close(); (window as any).ikmBrief?.(a); }, 250);
    }},
    time: { help: 'time & weather in Batangas', run: () => {
      const fn = (window as any).ikmLocalTime;
      print({ t: '> ', c: 'term-gold' }, fn ? fn() : new Date().toLocaleString('en-PH', { timeZone: 'Asia/Manila' }));
    }},
    projects: { help: 'list projects', run: () => {
      projects.forEach((p: any, i: number) => {
        print({ t: `0${i + 1}  `, c: 'term-dim' }, { t: p.id.padEnd(26), cmd: `open ${p.id}`, c: 'term-k' }, `${p.type} · ${p.year}`);
        print({ t: '    ' }, { t: p.tagline, c: 'term-dim' });
      });
      gap(); print('Try ', { t: 'open barangay', cmd: 'open barangay' }, ' or ', { t: 'demo bakery', cmd: 'demo bakery' });
    }},
    open: { help: 'open <project> — go to a project page', run: a => {
      const p = find(a);
      if (!a || !p) return print({ t: 'usage: open <project>  ', c: 'term-err' }, '— see ', { t: 'projects', cmd: 'projects' });
      print(`opening ${p.title}…`); setTimeout(() => location.href = `/projects/${p.id}/`, 350);
    }},
    demo: { help: 'demo <project> — jump straight to a live demo', run: a => {
      const p = find(a);
      if (!a || !p) return print({ t: 'usage: demo <project>', c: 'term-err' });
      print(`launching ${p.title} demo…`); setTimeout(() => location.href = `/projects/${p.id}/#demo`, 350);
    }},
    skills: { help: 'what Ian works with', run: () => profile.skillGroups.forEach(([k, v]: [string, string]) => print({ t: '▸ ', c: 'term-gold' }, { t: k + ': ', c: 'term-hi' }, v)) },
    education: { help: 'schools', run: () => profile.education.forEach((s: string) => print({ t: '▸ ', c: 'term-gold' }, s)) },
    certs: { help: 'certifications', run: () => profile.certifications.forEach((s: string) => print({ t: '✓ ', c: 'term-ok' }, s)) },
    contact: { help: 'ways to reach Ian', run: () => {
      print({ t: 'linkedin ', c: 'term-dim' }, { t: 'in/ian-karvey-manimtim', href: profile.contact.linkedin });
      print({ t: 'email    ', c: 'term-dim' }, { t: profile.contact.personalEmail, href: `mailto:${profile.contact.personalEmail}` });
      print({ t: 'school   ', c: 'term-dim' }, { t: profile.contact.schoolEmail, href: `mailto:${profile.contact.schoolEmail}` });
      print({ t: 'phone    ', c: 'term-dim' }, { t: profile.contact.phone, href: `tel:${profile.contact.phone.replace(/\s/g, '')}` });
      print({ t: 'facebook ', c: 'term-dim' }, { t: 'Karvey Laurel', href: profile.contact.facebook });
    }},
    ask: { help: 'ask <question> — ask Ian\'s AI anything', run: async a => {
      if (!a) return print({ t: 'usage: ask <question>   e.g. ', c: 'term-err' }, { t: 'ask what is Barangay Safety?', cmd: 'ask what is Barangay Safety?' });
      aiTurns.push({ role: 'user', text: a });
      const wait = print({ t: 'thinking', c: 'term-dim term-wait' });
      try {
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: aiTurns.slice(-8) }) });
        const d = await res.json().catch(() => ({}));
        wait.remove();
        if (d.reply) { aiTurns.push({ role: 'model', text: d.reply }); d.reply.replace(/\*\*(.+?)\*\*/g, '$1').split('\n').forEach((l: string) => print({ t: '│ ', c: 'term-gold' }, l.replace(/^\s*\*\s+/, '- '))); }
        else { aiTurns.pop(); print({ t: d.error || 'no answer', c: 'term-err' }); }
      } catch { wait.remove(); aiTurns.pop(); print({ t: 'network error', c: 'term-err' }); }
    }},
    goto: { help: 'goto <about|education|skills|experience|projects|certs>', run: a => {
      const id = ['about', 'education', 'skills', 'experience', 'projects', 'certs'].find(s => s.startsWith(a.toLowerCase()));
      if (!a || !id) return print({ t: 'usage: goto about|education|skills|experience|projects|certs', c: 'term-err' });
      close(); location.href = `/#${id}`;
    }},
    ls: { help: '_', run: () => print(...projects.map((p: any) => ({ t: p.id + '/  ', cmd: `open ${p.id}`, c: 'term-k' }))) },
    cd: { help: '_', run: a => commands.open.run(a.replace(/\/$/, '')) },
    clear: { help: 'clear the screen', run: () => { out.innerHTML = ''; } },
    exit: { help: 'close the terminal', run: () => close() },
    hire: { help: '_', run: () => commands.recruiter.run('') },
    sudo: { help: '_', run: a => {
      if (/hire/.test(a)) {
        print({ t: '[sudo] password for recruiter: ********', c: 'term-dim' });
        print({ t: '✓ access granted. ', c: 'term-ok' }, 'Excellent decision. Opening contact channels…');
        setTimeout(() => { commands.contact.run(''); commands.cv.run(''); }, 400);
      } else print({ t: `${a || 'sudo'}: permission denied — but `, c: 'term-err' }, { t: 'sudo hire ian', cmd: 'sudo hire ian' }, ' might work.');
    }},
    date: { help: '_', run: () => print(new Date().toString()) },
    echo: { help: '_', run: a => print(a) },
  };

  async function run(raw: string) {
    const line = raw.trim();
    print({ t: 'ian@portfolio:~$ ', c: 'term-ps' }, line);
    if (!line) return;
    past.push(line); pi = past.length;
    const [name, ...rest] = line.split(/\s+/);
    const cmd = commands[name.toLowerCase()];
    if (cmd) await cmd.run(rest.join(' '));
    else print({ t: `command not found: ${name}. `, c: 'term-err' }, 'Type ', { t: 'help', cmd: 'help' }, ' — or just ', { t: `ask ${line}`, cmd: `ask ${line}` });
  }

  function boot() {
    print({ t: 'IKM-OS 2.0', c: 'term-hi' }, { t: '  ·  portfolio shell', c: 'term-dim' });
    print({ t: 'Welcome. Type ', c: 'term-dim' }, { t: 'help', cmd: 'help' }, { t: ' to begin, or try ', c: 'term-dim' }, { t: 'projects', cmd: 'projects' }, { t: ', ', c: 'term-dim' }, { t: 'whoami', cmd: 'whoami' }, { t: ', ', c: 'term-dim' }, { t: 'ask …', cmd: 'ask what makes Ian a good hire?' });
    gap();
  }
  function open() {
    term.hidden = false;
    document.documentElement.classList.add('term-open');
    requestAnimationFrame(() => term.classList.add('on'));
    if (!booted) { boot(); booted = true; }
    setTimeout(() => input.focus(), 60);
  }
  function close() {
    term.classList.remove('on');
    document.documentElement.classList.remove('term-open');
    setTimeout(() => { if (!term.classList.contains('on')) term.hidden = true; }, 250);
  }

  form.addEventListener('submit', e => { e.preventDefault(); const v = input.value; input.value = ''; run(v); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowUp') { e.preventDefault(); if (pi > 0) input.value = past[--pi]; }
    else if (e.key === 'ArrowDown') { e.preventDefault(); pi = Math.min(past.length, pi + 1); input.value = past[pi] ?? ''; }
    else if (e.key === 'Tab') {
      e.preventDefault();
      const [n, ...r] = input.value.split(' ');
      if (!r.length) { const m = Object.keys(commands).filter(k => k.startsWith(n)); if (m.length === 1) input.value = m[0] + ' '; else if (m.length) print({ t: m.join('   '), c: 'term-dim' }); }
      else { const p = find(r.join(' ')); if (p) input.value = `${n} ${p.id}`; }
    }
  });
  out.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('.term-cmd') as HTMLElement | null;
    if (b?.dataset.cmd) run(b.dataset.cmd);
    else if (!(e.target as HTMLElement).closest('a')) input.focus();
  });
  term.addEventListener('click', e => { if ((e.target as HTMLElement).closest('[data-term-close]')) close(); });
  document.addEventListener('click', e => { if ((e.target as HTMLElement).closest('[data-open-terminal]')) open(); });
  document.addEventListener('keydown', e => {
    const typing = /INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName);
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); term.hidden ? open() : close(); }
    else if (e.key === '`' && !typing && term.hidden) { e.preventDefault(); open(); }
    else if (e.key === 'Escape' && !term.hidden) close();
  });
</script>

<style is:global>
  .term{position:fixed;inset:0;z-index:99980;display:flex;align-items:center;justify-content:center;padding:16px}
  .term[hidden]{display:none}
  .term-backdrop{position:absolute;inset:0;background:rgba(8,7,5,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0;transition:opacity .25s}
  .term-win{
    position:relative;width:min(760px,100%);height:min(520px,82svh);
    display:flex;flex-direction:column;
    background:#0a0907;border:.7px solid rgba(219,185,94,.28);border-radius:8px;
    box-shadow:0 40px 120px rgba(0,0,0,.7),0 0 0 1px rgba(0,0,0,.6);
    font-family:var(--mono);font-size:13px;line-height:1.7;color:#d8cfbf;
    opacity:0;transform:translateY(14px) scale(.985);transition:opacity .25s,transform .35s cubic-bezier(.25,1,.5,1);
  }
  .term.on .term-backdrop,.term.on .term-win{opacity:1}
  .term.on .term-win{transform:none}
  .term-bar{display:flex;align-items:center;gap:14px;padding:10px 14px;border-bottom:.6px solid rgba(244,239,230,.07)}
  .term-dots{display:flex;gap:6px}
  .term-dots i{width:10px;height:10px;border-radius:50%;background:#3a332a}
  .term-dots i:first-child{background:#e0574b}
  .term-dots i:nth-child(2){background:#dbb95e}
  .term-dots i:nth-child(3){background:#63ab33}
  .term-name{flex:1;text-align:center;font-size:11px;color:var(--fg3);letter-spacing:.06em}
  .term-x{background:none;border:.6px solid var(--brd2);color:var(--fg3);font-family:var(--mono);font-size:9px;letter-spacing:.12em;padding:3px 8px;border-radius:2px;cursor:pointer}
  .term-out{flex:1;overflow-y:auto;padding:16px 18px 4px;overscroll-behavior:contain}
  .term-l{white-space:pre-wrap;word-break:break-word;min-height:1.7em}
  .term-line{display:flex;align-items:center;gap:10px;padding:8px 18px 16px}
  .term-ps{color:#63ab33;white-space:nowrap}
  .term-line .term-ps{font-size:13px}
  .term-line input{flex:1;min-width:0;background:none;border:none;outline:none;color:#f4efe6;font:inherit;caret-color:var(--gold)}
  .term-hi{color:#f4efe6;font-weight:400}
  .term-dim{color:#8a7d68}
  .term-gold,.term-k{color:var(--gold)}
  .term-ok{color:#7fd08a}
  .term-err{color:#f0a59d}
  .term-l a{color:var(--gold);text-underline-offset:3px}
  .term-cmd{white-space:pre;background:none;border:none;padding:0;font:inherit;color:var(--gold);text-decoration:underline dotted rgba(219,185,94,.5);text-underline-offset:4px;cursor:pointer}
  html:not(.touch) .term-cmd,html:not(.touch) .term-x{cursor:none}
  .term-cmd:hover{color:var(--gold2)}
  .term-wait::after{content:'…';animation:blink 1s steps(1) infinite}
  @media(max-width:680px){.term-win{font-size:12px;height:min(560px,86svh)}}
</style>
