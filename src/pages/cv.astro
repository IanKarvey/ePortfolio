---
/* Ian's CV, in the resume format he chose, from src/data/cv.ts.
   /Ian-Karvey-Manimtim-CV.pdf is this page printed to A4 — regenerate it after editing cv.ts
   (run the dev server, then print http://localhost:4321/cv/ to PDF). */
import { cv } from '../data/cv';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resume — {cv.name}</title>
<meta name="description" content={`Resume of ${cv.name}`}>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<div class="bar">
  <a href="/">← Portfolio</a>
  <span>
    <a href="/Ian-Karvey-Manimtim-CV.pdf" download>Download PDF</a>
    <button type="button" onclick="window.print()">Print</button>
  </span>
</div>

<main class="cv">
  <header class="cv-head">
    <div class="cv-id">
      <h1>{cv.name}</h1>
      <p class="cv-line">
        {cv.contact.map(([k, v], i) => <><b>{k}:</b> {v}{i < cv.contact.length - 1 && <span class="sep">|</span>}</>)}
      </p>
      <p class="cv-line">
        {cv.links.map(([k, v], i) => <><b>{k}:</b> {v}{i < cv.links.length - 1 && <span class="sep">|</span>}</>)}
      </p>
    </div>
    <img class="cv-photo" src={cv.photo} alt={cv.name}>
  </header>

  <section>
    <h2>Professional Summary</h2>
    <p class="cv-summary">{cv.summary}</p>
  </section>

  <section>
    <h2>Key Skills</h2>
    <ul>{cv.skills.map(([k, v]) => <li><b>{k}:</b> {v}</li>)}</ul>
  </section>

  <section>
    <h2>Professional Experience</h2>
    {cv.experience.map(x => (
      <div class="cv-item">
        <div class="cv-role">{x.role}</div>
        <div class="cv-where">{x.where} | {x.when}</div>
        <ul>
          {x.points.map(p => <li>{p}</li>)}
          {x.sub.map(s => (
            <li class="cv-sub"><b>{s.title}</b>
              <ul>{s.points.map(p => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Projects and Achievements</h2>
    {cv.projects.map(p => (
      <div class="cv-item">
        <div class="cv-role">{p.title}</div>
        <ul>{p.points.map(t => <li>{t}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Education</h2>
    {cv.education.map(([degree, school, years, honors]) => (
      <div class="cv-edu">
        <div class="cv-role">{degree}</div>
        <div class="cv-school">{school} | {years}</div>
        {honors && <div class="cv-school cv-honors"><b>Awards:</b> {honors}</div>}
      </div>
    ))}
  </section>

  <section>
    <h2>Certifications</h2>
    <ul class="cv-certs">{cv.certifications.map(c => <li>{c}</li>)}</ul>
  </section>

  <section>
    <h2>References</h2>
    {cv.references.length ? (
      <div class="cv-refs">
        {cv.references.map(r => (
          <div><b>{r.name}</b><span>{r.title}</span><span>{r.email}</span><span>{r.phone}</span></div>
        ))}
      </div>
    ) : <p class="cv-avail">Available upon request.</p>}
  </section>
</main>

<style is:global>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{background:#e8e8e8;color:#111;font-family:'Poppins',Arial,sans-serif;-webkit-font-smoothing:antialiased}
  .bar{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;padding:12px 20px;background:#1b1813;font-size:12px}
  .bar a,.bar button{color:#f3eee4;text-decoration:none;background:none;border:1px solid #4a4237;border-radius:3px;padding:7px 12px;font:inherit;cursor:pointer;margin-left:6px}
  .bar a:first-child{border:none;padding-left:0;margin:0}
  .cv{width:210mm;min-height:297mm;margin:24px auto;padding:12mm 14mm;background:#fff;box-shadow:0 10px 40px rgba(0,0,0,.15);font-size:8.4pt;line-height:1.36}

  .cv-head{display:grid;grid-template-columns:1fr 27mm;gap:6mm;align-items:center}
  .cv-id{text-align:center}
  h1{font-size:25pt;font-weight:800;line-height:1.1;letter-spacing:-.01em;padding-bottom:1.5mm;border-bottom:1pt solid #111;margin-bottom:2mm}
  .cv-line{font-size:8.6pt;line-height:1.6}
  .cv-line b{font-weight:700}
  .sep{margin:0 2mm;color:#777}
  .cv-photo{width:27mm;height:31mm;object-fit:cover;object-position:50% 16%;border-radius:2mm}

  section{margin-top:2.7mm}
  h2{font-size:9.6pt;font-weight:700;padding-bottom:.8mm;margin-bottom:1.8mm;border-bottom:.8pt solid #111}
  .cv-summary{text-align:justify}
  ul{margin-left:4.5mm}
  li{margin-bottom:.2mm}
  li b{font-weight:600}
  .cv-item{margin-bottom:2mm;break-inside:avoid}
  .cv-role{font-weight:700;font-size:9pt}
  .cv-where{font-weight:600;margin-bottom:.8mm}
  .cv-sub{margin-top:1mm;list-style:disc}
  .cv-sub > ul{margin-top:.6mm;list-style:circle}
  .cv-edu{margin-bottom:1.6mm}
  .cv-school{padding-left:6mm;color:#333}
  .cv-honors b{font-weight:600;color:#111}
  .cv-avail{font-style:italic;color:#333}
  .cv-certs{display:grid;grid-template-columns:1fr 1fr;column-gap:8mm}
  .cv-refs{display:grid;grid-template-columns:1fr 1fr;gap:4mm}
  .cv-refs div{display:flex;flex-direction:column}
  .cv-refs span{font-size:8pt;color:#333}

  /* real page margins, so a second page never starts flush against the paper edge */
  @page{size:A4;margin:8mm 12mm}
  @media print{
    body{background:#fff}
    .bar{display:none}
    .cv{margin:0;padding:0;box-shadow:none;width:auto;min-height:0}
  }
  @media screen and (max-width:820px){
    .cv{width:auto;min-height:0;margin:0;padding:22px 16px;font-size:13px}
    .cv-head{grid-template-columns:1fr;justify-items:center}
    .cv-photo{order:-1;width:96px;height:110px}
    h1{font-size:28px}
    .cv-line .sep{display:none}
    .cv-line b{display:inline-block;margin-left:8px}
    .cv-refs{grid-template-columns:1fr}
  }
</style>
</body>
</html>
