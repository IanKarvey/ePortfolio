---
/* Printable one-page CV, built from the same data as the site so it never drifts.
   /Ian-Karvey-Manimtim-CV.pdf is this page printed to A4 (regenerate after content changes:
   run the dev server, then print http://localhost:4321/cv/ to PDF with margins "none"). */
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const skillGroups = [
  ['Mobile & Web', 'Flutter, Dart, UI/UX design, responsive web'],
  ['Backend & Data', 'Supabase, PostgreSQL, SQL, row-level security, Node.js, REST APIs'],
  ['Desktop & Analytics', 'Python, Tkinter, Matplotlib, Power BI, UiPath'],
  ['Foundations', 'C++, software architecture, automated testing, Adobe tools'],
];
const site = 'karveyportfolio.vercel.app';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CV — {profile.name}</title>
<meta name="description" content={`Curriculum vitae of ${profile.name} — ${profile.headline}`}>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600&family=Fraunces:opsz,wght,SOFT@9..144,400..900,0..100&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
</head>
<body>
<div class="bar">
  <a href="/">← Portfolio</a>
  <span>
    <a href="/Ian-Karvey-Manimtim-CV.pdf" download>Download PDF</a>
    <button type="button" onclick="window.print()">Print</button>
  </span>
</div>

<main class="cv">
  <header class="cv-head">
    <div>
      <h1>{profile.name}</h1>
      <p class="cv-title">{profile.headline}</p>
      <span class="cv-avail">● {profile.availability}</span>
    </div>
    <ul class="cv-contact">
      <li>{profile.contact.personalEmail}</li>
      <li>{profile.contact.schoolEmail}</li>
      <li>{profile.contact.phone}</li>
      <li>{profile.location}</li>
      <li class="cv-site">{site}</li>
    </ul>
  </header>

  <section>
    <h2>Career objective</h2>
    <p class="cv-obj">{profile.objective}</p>
  </section>

  <section>
    <h2>Projects <span>— sole developer on all three; live demos at {site}</span></h2>
    {projects.map(p => (
      <article class="cv-proj">
        <div class="cv-row">
          <h3>{p.data.title}</h3>
          <span class="cv-meta">{p.data.type} · {p.data.year} · {p.data.status}</span>
        </div>
        <p>{p.data.tagline}</p>
        <ul>
          {p.data.features.slice(0, 3).map(f => <li><b>{f.title}.</b> {f.text.split(/(?<=\.)\s/)[0]}</li>)}
        </ul>
        <p class="cv-stack">{p.data.stack.join(' · ')}</p>
      </article>
    ))}
  </section>

  <div class="cv-cols">
    <section>
      <h2>Education</h2>
      <div class="cv-edu">
        <div class="cv-row"><h3>De La Salle Lipa</h3><span class="cv-meta">2023 – 2027</span></div>
        <p>Bachelor of Science in Information Technology — currently 4th year</p>
      </div>
      <div class="cv-edu">
        <div class="cv-row"><h3>San Guillermo Academy</h3><span class="cv-meta">2021 – 2023</span></div>
        <p>Senior High School</p>
      </div>

      <h2 class="cv-gap">Skills</h2>
      <dl class="cv-skills">
        {skillGroups.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      </dl>
    </section>

    <section>
      <h2>Certifications</h2>
      <ul class="cv-certs">{profile.certifications.map(c => <li>{c}</li>)}</ul>

      <h2 class="cv-gap">Strengths</h2>
      <p class="cv-plain">{profile.strengths.join(' · ')}</p>

      <h2 class="cv-gap">Languages</h2>
      <p class="cv-plain">{profile.languages.join(' · ')}</p>
    </section>
  </div>
</main>

<style is:global>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{--ink:#1b1813;--mut:#6e6556;--gold:#9a7420;--line:#e3dccd}
  body{background:#e9e3d6;color:var(--ink);font-family:'Josefin Sans',system-ui,sans-serif;font-weight:300;-webkit-font-smoothing:antialiased}
  .bar{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;padding:12px 20px;background:#1b1813;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.08em}
  .bar a,.bar button{color:#f3eee4;text-decoration:none;background:none;border:1px solid #4a4237;border-radius:3px;padding:7px 12px;font:inherit;cursor:pointer;margin-left:6px}
  .bar a:first-child{border:none;padding-left:0;margin:0}
  .cv{width:210mm;min-height:297mm;margin:24px auto;padding:13mm 14mm;background:#fdfbf7;box-shadow:0 20px 60px rgba(0,0,0,.18)}
  .cv-head{display:flex;justify-content:space-between;gap:20px;padding-bottom:5mm;border-bottom:2px solid var(--ink)}
  h1{font-family:'Fraunces',Georgia,serif;font-variation-settings:"SOFT" 100;font-weight:900;font-size:27pt;line-height:1;letter-spacing:-.01em}
  .cv-title{margin-top:5px;font-size:10.5pt;font-weight:400;color:#3d372e}
  .cv-avail{display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;background:#e2f3e2;border:1px solid #9fd3a6;color:#1f6b2c;font-size:8pt;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  .cv-contact{list-style:none;text-align:right;font-family:'DM Mono',monospace;font-size:7.6pt;line-height:1.75;color:#3d372e}
  .cv-site{color:var(--gold)}
  section{margin-top:4.6mm}
  h2{font-family:'DM Mono',monospace;font-weight:400;font-size:7.8pt;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);padding-bottom:1.4mm;margin-bottom:2.2mm;border-bottom:1px solid var(--line)}
  h2 span{letter-spacing:.04em;text-transform:none;color:var(--mut)}
  .cv-gap{margin-top:4mm}
  h3{font-family:'Fraunces',Georgia,serif;font-variation-settings:"SOFT" 100;font-weight:800;font-size:11.5pt}
  .cv-obj{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:10pt;line-height:1.45;color:#2e2a23}
  .cv-row{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
  .cv-meta{font-family:'DM Mono',monospace;font-size:7.4pt;color:var(--mut);white-space:nowrap}
  .cv-proj{margin-bottom:3mm}
  .cv-proj > p{font-size:9pt;color:#3d372e;margin-top:1px}
  .cv-proj ul{margin:1.4mm 0 0 4mm;font-size:8.6pt;line-height:1.45;color:#2e2a23}
  .cv-proj b{font-weight:600}
  .cv-proj .cv-stack{margin-top:1.2mm;font-family:'DM Mono',monospace;font-size:7.2pt;color:var(--gold)}
  .cv-cols{display:grid;grid-template-columns:1.15fr 1fr;gap:8mm}
  .cv-edu{margin-bottom:2.4mm}
  .cv-edu p,.cv-plain{font-size:9pt;color:#3d372e}
  .cv-skills{display:grid;grid-template-columns:auto 1fr;gap:1.3mm 4mm;font-size:8.6pt}
  .cv-skills dt{font-weight:600;white-space:nowrap}
  .cv-skills dd{color:#3d372e}
  .cv-certs{list-style:none;font-size:8.6pt;line-height:1.5;color:#2e2a23}
  .cv-certs li{padding-left:4mm;position:relative}
  .cv-certs li::before{content:'✓';position:absolute;left:0;color:#2f9a44}
  @page{size:A4;margin:0}
  @media print{
    body{background:#fff}
    .bar{display:none}
    .cv{margin:0;box-shadow:none;width:210mm;min-height:0;height:296mm;overflow:hidden}
  }
  @media screen and (max-width:820px){
    .cv{width:auto;min-height:0;margin:0;padding:22px 18px}
    .cv-head{flex-direction:column}
    .cv-contact{text-align:left}
    .cv-cols{grid-template-columns:1fr;gap:0}
  }
</style>
</body>
</html>
