---
/* Ian's CV, in the resume format he chose, from src/data/cv.ts.
   /Ian-Karvey-Manimtim-CV.pdf is this page printed to A4 — regenerate it after editing cv.ts
   (run the dev server, then print http://localhost:4321/cv/ to PDF). */
import { cv } from '../data/cv';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resume — {cv.name}</title>
<meta name="description" content={`Resume of ${cv.name}`}>
<meta name="robots" content="noindex">
</head>
<body>
<div class="bar">
  <a href="/">← Portfolio</a>
  <span>
    <a href="/Ian-Karvey-Manimtim-CV.pdf" download>Download PDF</a>
    <button type="button" onclick="window.print()">Print</button>
  </span>
</div>

<main class="cv">
  <header class="cv-head">
    <h1>{cv.name}</h1>
    <p class="cv-line">
      {cv.contact.map(([k, v], i) => <><b>{k}:</b> {v}{i < cv.contact.length - 1 && <span class="sep">|</span>}</>)}
    </p>
    <p class="cv-line">
      {cv.links.map(([k, v], i) => <><b>{k}:</b> {v}{i < cv.links.length - 1 && <span class="sep">|</span>}</>)}
    </p>
  </header>

  <section>
    <h2>Professional Summary</h2>
    <p class="cv-summary">{cv.summary}</p>
  </section>

  <section>
    <h2>Key Skills</h2>
    <ul>{cv.skills.map(([k, v]) => <li><b>{k}:</b> {v}</li>)}</ul>
  </section>

  <section>
    <h2>Experience</h2>
    {cv.experience.map(x => (
      <div class="cv-item">
        <div class="cv-role">{x.role}</div>
        <ul>
          {x.points.map(p => <li>{p}</li>)}
          {x.sub.map(s => (
            <li class="cv-sub"><div class="cv-row"><b>{s.title}</b><span class="cv-date">{s.date}</span></div>
              <ul>{s.points.map(p => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Projects and Achievements</h2>
    {cv.projects.map(p => (
      <div class="cv-item">
        <div class="cv-row"><span class="cv-role">{p.title}</span><span class="cv-date">{p.date}</span></div>
        <ul>{p.points.map(t => <li>{t}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Education</h2>
    {cv.education.map(([degree, school, years, honors]) => (
      <div class="cv-edu">
        <div class="cv-role">{degree}</div>
        <div class="cv-school">{school} | {years}</div>
        {honors && <div class="cv-school cv-honors"><b>Awards:</b> {honors}</div>}
      </div>
    ))}
  </section>

  <section>
    <h2>Certifications</h2>
    <ul class="cv-certs">{cv.certifications.map(c => <li>{c}</li>)}</ul>
  </section>

  <section>
    <h2>References</h2>
    {cv.references.length ? (
      <div class="cv-refs">
        {cv.references.map(r => (
          <div><b>{r.name}</b><span>{r.title}</span><span>{r.email}</span><span>{r.phone}</span></div>
        ))}
      </div>
    ) : <p class="cv-avail">Available upon request.</p>}
  </section>
</main>

<style is:global>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  /* --fs (text size) and --gap (space between sections) are tuned so the content fills exactly one A4 page */
  :root{--fs:9.6pt;--gap:4.2mm}
  body{background:#e8e8e8;color:#111;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  .bar{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;padding:12px 20px;background:#1b1813;font-size:12px}
  .bar a,.bar button{color:#f3eee4;text-decoration:none;background:none;border:1px solid #4a4237;border-radius:3px;padding:7px 12px;font:inherit;cursor:pointer;margin-left:6px}
  .bar a:first-child{border:none;padding-left:0;margin:0}
  .cv{width:210mm;min-height:297mm;margin:24px auto;padding:12mm 14mm;background:#fff;box-shadow:0 10px 40px rgba(0,0,0,.15);font-size:var(--fs);line-height:1.38}

  /* no photo: name, full-width rule and contact lines, all centred */
  .cv-head{text-align:center}
  h1{font-family:'Arial Black',Arial,sans-serif;font-size:26pt;font-weight:900;line-height:1.1;letter-spacing:-.01em;padding-bottom:1.8mm;border-bottom:1.2pt solid #111;margin-bottom:2.4mm}
  .cv-line{font-size:calc(var(--fs) * .98);line-height:1.65}
  .cv-line b{font-weight:700}
  .sep{margin:0 2mm;color:#888}

  section{margin-top:var(--gap)}
  h2{font-size:calc(var(--fs) * 1.16);font-weight:700;padding-bottom:.9mm;margin-bottom:2mm;border-bottom:.9pt solid #111}
  .cv-summary{text-align:justify}
  ul{margin-left:5mm;list-style:disc}
  li{margin-bottom:.5mm}
  li b{font-weight:700}
  .cv-item{margin-bottom:2.2mm;break-inside:avoid}
  .cv-row{display:flex;justify-content:space-between;align-items:baseline;gap:6mm}
  .cv-role{font-weight:700;font-size:calc(var(--fs) * 1.03)}
  .cv-date{font-weight:700;white-space:nowrap;flex-shrink:0}
  .cv-sub{margin-top:1.2mm}
  .cv-sub > ul{margin-top:.7mm;list-style:circle}
  .cv-edu{margin-bottom:2mm}
  .cv-school{padding-left:6mm;color:#333}
  .cv-honors b{font-weight:700;color:#111}
  .cv-avail{font-style:italic;color:#333}
  .cv-certs{display:grid;grid-template-columns:1fr 1fr;column-gap:8mm}
  .cv-refs{display:grid;grid-template-columns:1fr 1fr;gap:4mm}
  .cv-refs div{display:flex;flex-direction:column}
  .cv-refs span{font-size:calc(var(--fs) * .92);color:#333}

  /* real page margins, so a second page never starts flush against the paper edge */
  @page{size:A4;margin:11mm 14mm}
  @media print{
    /* tuned so the current content fills exactly one A4 page — re-tune if the CV grows */
    :root{--fs:8.3pt;--gap:4.4mm}
    body{background:#fff}
    .bar{display:none}
    .cv{margin:0;padding:0;box-shadow:none;width:auto;min-height:0}
  }
  @media screen and (max-width:820px){
    .cv{width:auto;min-height:0;margin:0;padding:22px 16px;font-size:13px}
    h1{font-size:28px}
    .cv-line .sep{display:none}
    .cv-line b{display:inline-block;margin-left:8px}
    .cv-refs{grid-template-columns:1fr}
  }
</style>
</body>
</html>
